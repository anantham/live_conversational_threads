          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 717,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I feel like I'm good at achieving that.",
          "timestamp_start": 2817.4,
          "timestamp_end": 2819.46,
          "duration_seconds": 2.0599999999999454
        },
        {
          "id": "b32866ce-51aa-4bc9-a3c9-9c75de0dd8e7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 718,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Now we have like a six part series now.",
          "timestamp_start": 2819.46,
          "timestamp_end": 2822.28,
          "duration_seconds": 2.8200000000001637
        },
        {
          "id": "f2de3051-c65b-43d8-871f-f4b04b0e2f04",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 719,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "The audience will not like, we have to use AI to chapterize this into like proper segments",
          "timestamp_start": 2822.28,
          "timestamp_end": 2829.46,
          "duration_seconds": 7.179999999999836
        },
        {
          "id": "0b3791f3-3f37-4621-87b0-c8e1bf103bf0",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
