          "211b004b-255e-4a7c-9e9b-25c9a7f244f5",
          "7a4831e8-13a9-44ce-9c2b-d81d3797e5f8",
          "035076f5-fd41-4488-b87a-4d29a60b7cd2",
          "3735b8e1-d972-4402-8c4c-53a63123d1bb",
          "f1cc33fe-24ec-49ca-a9cd-2bdf890e2244",
          "3be62fc7-7b18-4228-bd46-5c55f250ae30",
          "0ae58ddc-8d19-47de-ad61-2b9eefb2aae0",
          "59455fd7-28bf-49f4-93f0-1ef8afe26848",
          "33f39398-d2f9-4d85-b8c4-bdc28c7c8f30",
          "7d59d0e3-10e2-4352-a63a-f2d822b2a92c",
          "0966065e-ba7d-4c4b-9737-b1ba2cff002a"
        ]
      },
      "source_turns": [
        {
          "id": "44c73e84-6961-4050-86be-0bfaf5370403",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 182,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I was studying instrumentation and control engineering and we work with",
          "timestamp_start": 776.18,
          "timestamp_end": 780.7399999999999,
          "duration_seconds": 4.559999999999945
        },
        {
          "id": "83d6a737-a05c-4948-af3b-598fd383a8c3",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 183,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "transistors and we work with electronics and we didn't have that great",
          "timestamp_start": 780.7399999999999,
          "timestamp_end": 784.4,
          "duration_seconds": 3.660000000000082
        },
        {
          "id": "08558ca1-50b8-4dce-a377-8138f179daac",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 184,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "facilities. I would say, even though we were a national college and we had like",
          "timestamp_start": 784.68,
          "timestamp_end": 788.5999999999999,
          "duration_seconds": 3.919999999999959
        },
        {
          "id": "49577008-4d0f-4a2e-b686-f6cf70ecc153",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 185,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "good rankings, the equipment available in the labs and students' interest",
          "timestamp_start": 788.78,
          "timestamp_end": 793.88,
          "duration_seconds": 5.100000000000023
        },
        {
          "id": "beb95222-92b2-4d1c-bf1b-8c9e70d577e2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 186,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "towards doing the experiments, I wouldn't say was up to par.",
          "timestamp_start": 793.88,
          "timestamp_end": 797.3,
          "duration_seconds": 3.419999999999959
        },
        {
          "id": "a7f3aecb-45b4-4401-a358-c61ea6deb012",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 187,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like people, I don't know how it was in your college, but they often decide",
          "timestamp_start": 797.5999999999999,
          "timestamp_end": 801.5,
          "duration_seconds": 3.900000000000091
        },
        {
          "id": "a0a0cdf8-4161-4a03-9708-a606138ff7af",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 188,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "the theoretical values and they perturb the theoretical values to make the",
          "timestamp_start": 801.5,
          "timestamp_end": 805.04,
          "duration_seconds": 3.5399999999999636
        },
        {
          "id": "f6aedef1-eb35-43c7-ac71-9396a1a23a04",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 189,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "experimental values and they do all the lab work in a way to just get marks.",
          "timestamp_start": 805.04,
          "timestamp_end": 809.78,
          "duration_seconds": 4.740000000000009
        },
        {
          "id": "e37cf9ce-a801-48b9-9af7-1d4ed5eaaa47",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 190,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "They don't really care about the actual experiment.",
          "timestamp_start": 809.78,
          "timestamp_end": 811.8199999999999,
          "duration_seconds": 2.0399999999999636
        },
        {
          "id": "3559a888-5edf-4a34-9011-9ab308e36a07",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 191,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And it was breaking me up because as a scientist, I had the spirit of a curious person.",
          "timestamp_start": 812.68,
          "timestamp_end": 817.9599999999999,
          "duration_seconds": 5.279999999999973
        },
        {
          "id": "0265bf04-46ce-4a7b-8acf-f40836ddc6c7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 192,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I was like, I remember writing in the notebook, like experiment is not conductable because",
          "timestamp_start": 818.0799999999999,
          "timestamp_end": 822.1999999999999,
          "duration_seconds": 4.1200000000000045
        },
        {
          "id": "0683c14b-d862-4a95-a47a-ab71e0affa2a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 193,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "the instruments are not repeatable and stuff like that.",
          "timestamp_start": 822.1999999999999,
          "timestamp_end": 824.9,
          "duration_seconds": 2.7000000000000455
        },
        {
          "id": "626da66f-5ae0-4fa8-9b02-3ea7024872f8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 194,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I refused to go down to the peer pressure.",
          "timestamp_start": 824.98,
          "timestamp_end": 828.74,
          "duration_seconds": 3.759999999999991
        },
        {
          "id": "7e048760-5668-4141-90b2-8b9354f0787e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 195,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I used to ask questions in class, ask the questions to professors and ask them to explain things.",
          "timestamp_start": 828.9399999999999,
          "timestamp_end": 833.06,
          "duration_seconds": 4.1200000000000045
        },
        {
          "id": "9ce3eafc-dbdd-40cb-84d3-5a548a2344d9",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 196,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And then people used to fight with me.",
          "timestamp_start": 833.8199999999999,
          "timestamp_end": 835.52,
          "duration_seconds": 1.7000000000000455
        },
        {
          "id": "28d13340-7232-4c37-a157-207cb09cdb6a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 197,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I remember some students asked me, why are you making the class go on longer?",
          "timestamp_start": 835.52,
          "timestamp_end": 838.8,
          "duration_seconds": 3.2799999999999727
        },
        {
          "id": "a9e5a0a4-4a5b-4067-8d94-863e95ae06d7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 198,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "You know, like, let the teacher end the class.",
          "timestamp_start": 838.8,
          "timestamp_end": 841.8,
          "duration_seconds": 3
        },
        {
          "id": "8a7fa6c6-760a-42cb-91b7-d4db1513ba4d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 199,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I want to leave.",
          "timestamp_start": 841.8,
          "timestamp_end": 842.3599999999999,
          "duration_seconds": 0.5599999999999454
        },
        {
          "id": "97d1244e-0f86-47b2-86bd-94881c54a4dd",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 200,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "If you want to ask questions, ask them in your own time.",
          "timestamp_start": 842.3599999999999,
          "timestamp_end": 844.4599999999999,
          "duration_seconds": 2.1000000000000227
        },
        {
          "id": "211b004b-255e-4a7c-9e9b-25c9a7f244f5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 201,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Don't block the entire class for you.",
          "timestamp_start": 844.76,
          "timestamp_end": 846.3399999999999,
          "duration_seconds": 1.5799999999999272
        },
        {
          "id": "7a4831e8-13a9-44ce-9c2b-d81d3797e5f8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 202,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Don't be selfish that way.",
          "timestamp_start": 846.5799999999999,
          "timestamp_end": 847.54,
          "duration_seconds": 0.9600000000000364
        },
        {
          "id": "035076f5-fd41-4488-b87a-4d29a60b7cd2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 203,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And I was like, you guys came here to study, right?",
          "timestamp_start": 848.2199999999999,
          "timestamp_end": 850.0999999999999,
          "duration_seconds": 1.8799999999999955
        },
        {
          "id": "3735b8e1-d972-4402-8c4c-53a63123d1bb",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 204,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like, this is not even like a private college.",
          "timestamp_start": 850.0999999999999,
          "timestamp_end": 852.2399999999999,
          "duration_seconds": 2.1399999999999864
        },
        {
          "id": "f1cc33fe-24ec-49ca-a9cd-2bdf890e2244",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 205,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "This is like a government colleges.",
          "timestamp_start": 852.2399999999999,
          "timestamp_end": 853.4599999999999,
          "duration_seconds": 1.2200000000000273
        },
        {
          "id": "3be62fc7-7b18-4228-bd46-5c55f250ae30",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 206,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We got J E means you got good rank and came here and really love the subject.",
          "timestamp_start": 853.52,
          "timestamp_end": 857.8599999999999,
          "duration_seconds": 4.339999999999918
        },
        {
          "id": "0ae58ddc-8d19-47de-ad61-2b9eefb2aae0",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 207,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Don't you want to understand?",
          "timestamp_start": 857.8599999999999,
          "timestamp_end": 858.7399999999999,
          "duration_seconds": 0.8799999999999955
        },
        {
          "id": "59455fd7-28bf-49f4-93f0-1ef8afe26848",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 208,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So I was very frustrated because I didn't feel supported by a lot of people.",
          "timestamp_start": 859.3399999999999,
          "timestamp_end": 862.64,
          "duration_seconds": 3.300000000000068
        },
        {
          "id": "33f39398-d2f9-4d85-b8c4-bdc28c7c8f30",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 209,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And people are focused on getting marks, getting a job, getting, getting a resume",
          "timestamp_start": 862.64,
          "timestamp_end": 866.64,
          "duration_seconds": 4
        },
        {
          "id": "7d59d0e3-10e2-4352-a63a-f2d822b2a92c",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 210,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "padding with internships and papers.",
          "timestamp_start": 866.64,
          "timestamp_end": 868.86,
          "duration_seconds": 2.2200000000000273
        },
        {
          "id": "0966065e-ba7d-4c4b-9737-b1ba2cff002a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 211,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Everyone is in a rat race and there's no space for them to really explore the curiosity.",
          "timestamp_start": 869.18,
          "timestamp_end": 873.4,
          "duration_seconds": 4.220000000000027
        }
      ],
      "source_excerpt": "I was studying instrumentation and control engineering and we work with",
