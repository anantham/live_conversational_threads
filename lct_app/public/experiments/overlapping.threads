          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I have to talk to these AI systems.",
          "timestamp_start": 2559.6400000000003,
          "timestamp_end": 2561.38,
          "duration_seconds": 1.7399999999997817
        },
        {
          "id": "aa90cbbb-387f-480d-8617-f0f9bc758e5c",
