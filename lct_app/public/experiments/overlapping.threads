          "ab1c0b8f-2a79-46eb-8c64-af4a81098777",
          "2f3d3512-ed56-4e6d-8f96-4f4a60f27f3e",
          "04fa225c-db1d-4ce7-b4db-9c01bf8f6028"
        ]
      },
      "source_turns": [
        {
          "id": "9bc8db3d-5f12-439e-b50b-21e0b465229f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 490,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Exactly.",
          "timestamp_start": 1942.16,
          "timestamp_end": 1942.66,
          "duration_seconds": 0.5
        },
        {
          "id": "c58c0358-b1d2-471d-a232-e720398153b1",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 491,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So when I say interpretability, it'd be good if you can take this black box and break it",
          "timestamp_start": 1942.66,
          "timestamp_end": 1946.96,
          "duration_seconds": 4.2999999999999545
        },
        {
          "id": "30f03d11-c537-4304-b68d-1236f0ef93f2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 492,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "into smaller modular parts.",
          "timestamp_start": 1946.96,
          "timestamp_end": 1948.46,
          "duration_seconds": 1.5
        },
        {
          "id": "d9004e63-66cf-47e3-8072-f9c6d6bc4f14",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 493,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "If you can identify what each layer is doing, right?",
          "timestamp_start": 1948.46,
          "timestamp_end": 1951.16,
          "duration_seconds": 2.7000000000000455
        },
        {
          "id": "fe7eabb9-1c67-404a-a613-cdf16eaf1146",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 494,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like usually in image models, for example, we have noticed that certain layers, our job",
          "timestamp_start": 1951.16,
          "timestamp_end": 1957.8600000000001,
          "duration_seconds": 6.7000000000000455
        },
        {
          "id": "9db4e2aa-ec79-4b5b-a173-adebf61ffcfa",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 495,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "is to find edges and some, what do you call, so if you're trying to build a black box that",
          "timestamp_start": 1957.8600000000001,
          "timestamp_end": 1964.5600000000002,
          "duration_seconds": 6.7000000000000455
        },
        {
          "id": "034653f1-dbe5-4c40-9bae-c91a3adb6ad7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 496,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "just does detection of faces or cats and dogs or whatever,",
          "timestamp_start": 1964.56,
          "timestamp_end": 1968.3999999999999,
          "duration_seconds": 3.839999999999918
        },
        {
          "id": "bb90ae66-77ed-48d0-87b6-865a1dedf887",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 497,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "then you can kind of understand that, oh, yeah,",
          "timestamp_start": 1968.3999999999999,
          "timestamp_end": 1971.1,
          "duration_seconds": 2.7000000000000455
        },
        {
          "id": "71489490-b7bf-4fa5-b357-41d8fe0068c1",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 498,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "different parts of the black box is doing different things.",
          "timestamp_start": 1971.1,
          "timestamp_end": 1974.22,
          "duration_seconds": 3.1200000000001182
        },
        {
          "id": "032a8291-6b8e-4b3b-b008-e6357616804a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 499,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "This is what understanding might mean, right?",
          "timestamp_start": 1974.22,
          "timestamp_end": 1976.02,
          "duration_seconds": 1.7999999999999545
        },
        {
          "id": "b97ca58f-90e8-40ff-a34e-ad0e5c0fbf54",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 500,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like when human beings are put under a fMRI scan",
          "timestamp_start": 1976.02,
          "timestamp_end": 1979.1399999999999,
          "duration_seconds": 3.119999999999891
        },
        {
          "id": "07932d4c-33a1-45b4-b515-b9d42d1ec551",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 501,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "and when neurologists try to study what does the human brain",
          "timestamp_start": 1979.1399999999999,
          "timestamp_end": 1983.26,
          "duration_seconds": 4.120000000000118
        },
        {
          "id": "7183cdbe-8678-46b7-a27c-5934b5b785d8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 502,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "do, we kind of categorize the amygdala",
          "timestamp_start": 1983.26,
          "timestamp_end": 1986.04,
          "duration_seconds": 2.7799999999999727
        },
        {
          "id": "c458a07b-3a0f-40af-856a-cc72351368cf",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 503,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "and the prefrontal cortex.",
          "timestamp_start": 1986.04,
          "timestamp_end": 1987.3799999999999,
          "duration_seconds": 1.3399999999999181
        },
        {
          "id": "8f2b85ea-0066-4aca-800c-cd425b2862ec",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 504,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And we associate certain functions",
          "timestamp_start": 1987.3799999999999,
          "timestamp_end": 1989.1599999999999,
          "duration_seconds": 1.7799999999999727
        },
        {
          "id": "40891f0f-1f36-4e7e-ac64-5c49f3972160",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 505,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "with each part of the brain.",
          "timestamp_start": 1989.1599999999999,
          "timestamp_end": 1990.72,
          "duration_seconds": 1.5600000000001728
        },
        {
          "id": "ab1c0b8f-2a79-46eb-8c64-af4a81098777",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 506,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We're doing sort of reverse engineering,",
          "timestamp_start": 1990.72,
          "timestamp_end": 1992.12,
          "duration_seconds": 1.3999999999998636
        },
        {
          "id": "2f3d3512-ed56-4e6d-8f96-4f4a60f27f3e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 507,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "where we look at this thing and we try poking in different ways",
          "timestamp_start": 1992.12,
          "timestamp_end": 1995.78,
          "duration_seconds": 3.660000000000082
        },
        {
          "id": "04fa225c-db1d-4ce7-b4db-9c01bf8f6028",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 508,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "and trying to figure out how does the thing work.",
          "timestamp_start": 1995.78,
          "timestamp_end": 1999.2399999999998,
          "duration_seconds": 3.459999999999809
        }
      ],
      "source_excerpt": "Exactly.",
