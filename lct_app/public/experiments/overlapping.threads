          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "that, yeah, the next five, six years, 10 years is going to be insane.",
          "timestamp_start": 2705.8399999999997,
          "timestamp_end": 2709.66,
          "duration_seconds": 3.8200000000001637
        },
        {
          "id": "43d2f783-c765-4e48-a25d-0ebdb7ea3d44",
