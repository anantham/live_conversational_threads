          "duration_seconds": 2.899999999999636
        },
        {
          "id": "e9a8e479-b559-4552-b848-4efebe1c4997",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1122,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So all those are like real possibilities.",
          "timestamp_start": 4399.86,
          "timestamp_end": 4401.42,
          "duration_seconds": 1.5600000000004002
        },
        {
          "id": "81254431-cfb4-4e48-add0-96cf4680a663",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1123,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah.",
          "timestamp_start": 4402.36,
