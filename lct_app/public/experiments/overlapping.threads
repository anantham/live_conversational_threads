      "id": "demo-m18",
      "node_name": "A simple objective produced a surprise",
      "summary": "The interviewer marvels at next-word prediction's usefulness. Aditya says unexpected capabilities should prompt people to revise their models rather than move standards of intelligence after the fact.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
      "thread_label": null,
