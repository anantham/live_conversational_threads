    {
      "id": "demo-m45",
      "node_name": "Personalization can also subvert agency",
      "summary": "Aditya describes the effort required to understand another person's informational world. He warns that cheaper deepfakes, tailored media, and persuasion could deepen division and undermine individual agency.",
      "semantic_level": 1,
      "level": 1,
