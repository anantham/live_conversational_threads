          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "this.",
          "timestamp_start": 3668.3799999999997,
          "timestamp_end": 3669.3799999999997,
          "duration_seconds": 1
        },
        {
          "id": "b96b32e9-7615-4216-9be3-d75b3cd53d0a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 937,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So I don't have to like break the flow.",
          "timestamp_start": 3669.3799999999997,
          "timestamp_end": 3670.3399999999997,
          "duration_seconds": 0.9600000000000364
        },
        {
          "id": "911dbdbf-aec9-4223-9fc9-7f792dc5cdea",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 938,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I can be the flow with the conversation while also sending being like connect this conversation",
          "timestamp_start": 3670.3399999999997,
          "timestamp_end": 3675.52,
          "duration_seconds": 5.180000000000291
        },
        {
          "id": "de45cdc5-1a03-4f70-b007-1b5cf6314d4f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 939,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "to this idea in my note.",
          "timestamp_start": 3675.52,
          "timestamp_end": 3676.74,
          "duration_seconds": 1.2199999999998
        },
        {
          "id": "8c6f3f5c-0642-4c7e-a85d-dac8a0bd2764",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 940,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So my second brain, my obsidian notes, I can start forming connections while talking to",
          "timestamp_start": 3676.74,
          "timestamp_end": 3681.08,
          "duration_seconds": 4.3400000000001455
        },
        {
          "id": "2b296dff-2e52-48cd-b986-15c9eb71391f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 941,
          "speaker_id": "SPEAKER_01",
