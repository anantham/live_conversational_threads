          "speaker_revision": 0,
          "text": "yeah well this happens in our lives too right we also control we have set up",
          "timestamp_start": 1118.82,
          "timestamp_end": 1123.7,
          "duration_seconds": 4.880000000000109
        },
        {
          "id": "882471f8-07f5-48fb-abce-02824d389f46",
