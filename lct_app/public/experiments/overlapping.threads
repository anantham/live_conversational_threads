      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "The algorithm will keep tweaking these knobs slowly, slowly, slowly,",
      "timestamp_start": 1776.3,
