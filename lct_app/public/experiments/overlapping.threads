    {
      "id": "demo-m06",
      "node_name": "Was consciousness already an obsession?",
      "summary": "Asked about early metaphysical interests, Aditya says he mostly enjoyed comics, anime, and games. He retrospectively describes a broadly reductionist outlook rather than sustained inquiry into consciousness.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
      "thread_label": null,
