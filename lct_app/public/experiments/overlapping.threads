          "sequence_number": 708,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think we finished like part one right now, right?",
          "timestamp_start": 2789.22,
          "timestamp_end": 2792.22,
          "duration_seconds": 3
        },
        {
          "id": "ab541e0c-925e-49d0-adb0-0fc3868dd6a2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
