          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "faster you're not running fast enough and i was like oh my god what i what is what kind of dystopia",
          "timestamp_start": 1104.74,
          "timestamp_end": 1109.06,
          "duration_seconds": 4.319999999999936
        },
        {
          "id": "713f4822-6572-48cd-8818-d3f275dadfc6",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 277,
          "speaker_id": "SPEAKER_01",
