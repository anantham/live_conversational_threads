      "source_turns": [
        {
          "id": "6f040cb1-6edf-4cc0-9d88-7603c2a058c2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 726,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think we were discussing this.",
          "timestamp_start": 2842.78,
          "timestamp_end": 2844.78,
          "duration_seconds": 2
        },
        {
          "id": "d643907e-35ef-4bb7-91ae-e102cbd27217",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 727,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I mean, you had invited me to a meetup where Sahil was.",
          "timestamp_start": 2844.78,
          "timestamp_end": 2849.78,
          "duration_seconds": 5
        },
        {
          "id": "d92896f5-4d0a-4c55-8021-e216f5a211d1",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 728,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Is it okay to mention his name?",
          "timestamp_start": 2849.78,
          "timestamp_end": 2851.78,
          "duration_seconds": 2
        },
        {
          "id": "bc4cabef-3de5-4d1b-bb19-32097bda0fba",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 729,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I'm hoping, yeah.",
          "timestamp_start": 2851.78,
          "timestamp_end": 2852.78,
          "duration_seconds": 1
        },
        {
          "id": "cc3431cd-b219-4451-964d-0ca64412ef27",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 730,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah, yeah.",
          "timestamp_start": 2852.78,
          "timestamp_end": 2853.78,
          "duration_seconds": 1
        },
        {
          "id": "544b268b-8052-4f47-914c-2e5b0b5c51ee",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 731,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "You're sure you can mention his name.",
          "timestamp_start": 2853.78,
          "timestamp_end": 2854.78,
          "duration_seconds": 1
        },
        {
          "id": "5b11bdcd-e70c-48bf-9a89-cd83ff8a95b9",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 732,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I mean, he has made a public post about live theory now.",
          "timestamp_start": 2854.78,
          "timestamp_end": 2858.78,
          "duration_seconds": 4
        },
        {
          "id": "3e244b1a-1dd2-4273-af53-552065551c4f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 733,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So he's also starting an organization, which is hiring.",
          "timestamp_start": 2858.78,
          "timestamp_end": 2862.78,
          "duration_seconds": 4
        },
        {
          "id": "cecb6e42-0077-4e81-aa9f-7630cc993b02",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 734,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So we're looking for ML engineers who might be interested for contractual labor and working",
          "timestamp_start": 2862.78,
          "timestamp_end": 2869.2400000000002,
          "duration_seconds": 6.460000000000036
        },
        {
          "id": "0db1b47d-bc4e-4bdf-9322-91ea3786912c",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 735,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "on these projects so this might be one of the ways which people might find out about this and",
          "timestamp_start": 2869.24,
          "timestamp_end": 2873.5,
          "duration_seconds": 4.260000000000218
        },
        {
          "id": "33202bcd-98d1-45a5-b47a-1b56aef14d59",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 736,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "reach out to me or sahil if you want to like yeah and to the blog post but but i i do want to state",
          "timestamp_start": 2873.5,
          "timestamp_end": 2883.06,
          "duration_seconds": 9.559999999999945
        },
        {
          "id": "08362016-2936-4ade-8366-4a913bd48d46",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 737,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "that i can't be a spokesman for the organization or sahil i am just stating what i believe is my",
          "timestamp_start": 2883.06,
          "timestamp_end": 2888.3399999999997,
          "duration_seconds": 5.279999999999745
        },
        {
          "id": "d92b35a6-dbbc-4d91-a6bc-ef531b7bfa17",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 738,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "interpretation of his ideas because i yeah i'm not like the official i haven't even like officially",
          "timestamp_start": 2888.3399999999997,
          "timestamp_end": 2895.06,
          "duration_seconds": 6.720000000000255
        },
        {
          "id": "0647d6c9-dea6-42cf-b0bd-97c240796a0d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 739,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I like my freedom.",
          "timestamp_start": 2895.06,
          "timestamp_end": 2897.52,
          "duration_seconds": 2.4600000000000364
        },
        {
          "id": "0dc57a5a-23a0-4f67-99c8-31b838400844",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 740,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So I'm right now collaborating,",
          "timestamp_start": 2898.14,
          "timestamp_end": 2899.82,
          "duration_seconds": 1.680000000000291
        },
        {
          "id": "5cbe971e-18e7-468a-9d97-c3519fb8cd5d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 741,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "but I haven't got an official position yet.",
          "timestamp_start": 2900.06,
          "timestamp_end": 2902.96,
          "duration_seconds": 2.900000000000091
        },
        {
          "id": "548063fe-063c-4a90-999e-23cb97da4fc2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 742,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Got it.",
          "timestamp_start": 2903.7799999999997,
          "timestamp_end": 2904.14,
          "duration_seconds": 0.36000000000012733
        },
        {
          "id": "9b344126-34b8-42e1-9a0d-fcfa789ceaa3",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 743,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah, I mean, no affiliation.",
          "timestamp_start": 2904.64,
          "timestamp_end": 2907.16,
          "duration_seconds": 2.519999999999982
        },
        {
          "id": "f8433b5b-fdc6-49ea-9c35-e9b6a08ee2ae",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 744,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
