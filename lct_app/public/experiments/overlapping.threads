    },
    {
      "id": "878ce965-62c2-450d-a849-f7935eea4b61",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 1124,
      "speaker_id": "SPEAKER_00",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "Yeah.",
      "timestamp_start": 4404.839999999999,
      "timestamp_end": 4405.32,
      "duration_seconds": 0.48000000000047294
    },
    {
      "id": "e1c673ce-885f-4474-a15d-a259cf650bfb",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 1125,
      "speaker_id": "SPEAKER_00",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "I mean, it's worth trying to fix what could be a very, very bad future by trying some of these ideas out, right?",
      "timestamp_start": 4405.62,
      "timestamp_end": 4416.5199999999995,
      "duration_seconds": 10.899999999999636
    },
    {
      "id": "805d5f52-cf7a-4181-8198-85505c340578",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 1126,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "Yeah, I think the solution here will just look like giving control to the person involved, right?",
      "timestamp_start": 4417.32,
      "timestamp_end": 4421.599999999999,
      "duration_seconds": 4.279999999999745
    },
    {
      "id": "b623e670-8716-4b18-b25f-31bb0caa78f5",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 1127,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "Like let the AI really be controlled, not by, you don't buy the AI on subscription plan",
      "timestamp_start": 4421.6,
      "timestamp_end": 4427.42,
      "duration_seconds": 5.819999999999709
    },
    {
      "id": "a37ef542-d9fd-4d13-90b7-a71d60b792c9",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 1128,
      "speaker_id": "SPEAKER_01",
