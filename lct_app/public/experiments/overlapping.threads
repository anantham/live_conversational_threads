          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "much time they take in the bathroom break and things like that yeah that's been going on for so long",
          "timestamp_start": 1113.9399999999998,
          "timestamp_end": 1118.82,
          "duration_seconds": 4.880000000000109
        },
        {
          "id": "f48bdb96-9b63-40fe-a0eb-74c70a85e59f",
