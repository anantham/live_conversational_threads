      "id": "demo-m40",
      "node_name": "Learn mathematics in your own vocabulary",
      "summary": "Aditya imagines personalized mathematical terminology with AI translating between learners. Shared terminology currently supports communication; his proposal would try to preserve that function while permitting greater individual variation.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
