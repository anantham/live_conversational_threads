          "409f0ad3-601e-4ea0-9a18-44078da9aef8",
          "70a1dda0-9e9f-4add-92d6-e2fd004e61c5",
          "55fe2e15-eab8-4fc5-99bd-1a897f8e86f6",
          "4b881cec-497b-4ded-9920-0545441f47c1",
          "6d347013-1e5f-439b-b1f3-e60eaeab9f54",
          "eb090482-e438-4ede-9f34-a500cee1bc62"
        ]
      },
      "source_turns": [
        {
          "id": "11c5f726-58c3-4f61-a202-989d39e5c894",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 238,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think the safety aspects came in when I realized that people were really buying into",
          "timestamp_start": 949.18,
          "timestamp_end": 959.02,
          "duration_seconds": 9.840000000000032
        },
        {
          "id": "e63644a0-58bc-4485-98a5-313bbcdc0874",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 239,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "the myth of free will.",
          "timestamp_start": 959.02,
          "timestamp_end": 960.8199999999999,
          "duration_seconds": 1.7999999999999545
        },
        {
          "id": "2f35c12b-3c0e-4f76-aa9d-babed916852e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 240,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So Indians especially I could see that they were happy to use products for free, free",
          "timestamp_start": 960.8199999999999,
          "timestamp_end": 965.8,
          "duration_seconds": 4.980000000000018
        },
        {
          "id": "554e5919-e00a-4400-955b-a9973f047208",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 241,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Google search, free Facebook.",
          "timestamp_start": 965.8,
          "timestamp_end": 967.66,
          "duration_seconds": 1.8600000000000136
        },
        {
          "id": "664adcd5-463e-4a3f-af46-cc3b34c8a015",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 242,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Back in 2015, 2013, I was watching how no one wanted to pay for the products they used.",
          "timestamp_start": 967.66,
          "timestamp_end": 974.24,
          "duration_seconds": 6.580000000000041
        },
        {
          "id": "16f9a3af-82f9-40df-bed2-631d40b14fb8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 243,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "They spent all their time on the mobile phones and using all these applications and the incentives",
          "timestamp_start": 974.24,
          "timestamp_end": 978.8199999999999,
          "duration_seconds": 4.579999999999927
        },
        {
          "id": "f8cb6662-324b-4827-ab8c-d347c3715e9f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 244,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "were completely skewed where the developers were thinking not about their consumers, the",
          "timestamp_start": 978.82,
          "timestamp_end": 983.7,
          "duration_seconds": 4.8799999999999955
        },
        {
          "id": "68648777-91e2-41af-a549-67b2b66c5949",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 245,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "consumers were just users for them.",
          "timestamp_start": 983.7,
          "timestamp_end": 986.84,
          "duration_seconds": 3.1399999999999864
        },
        {
          "id": "8c3bf98e-8e50-4131-847f-cac6067d79d2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 246,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "They were thinking about advertisers.",
          "timestamp_start": 986.84,
          "timestamp_end": 988.7600000000001,
          "duration_seconds": 1.9200000000000728
        },
        {
          "id": "edd6b24f-7dbb-449e-86ac-aaef62bb3611",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 247,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "The monetizing was completely done where they were trying to get growth, get people to be",
          "timestamp_start": 988.7600000000001,
          "timestamp_end": 993.4200000000001,
          "duration_seconds": 4.659999999999968
        },
        {
          "id": "8444376f-8ccd-441c-baa0-9bcf3b3fb376",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 248,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "addicted to spend more time on their app.",
          "timestamp_start": 993.4200000000001,
          "timestamp_end": 995.36,
          "duration_seconds": 1.9399999999999409
        },
        {
          "id": "cdce23e4-0564-4854-a8b2-4c4f4b397d16",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 249,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Even dating apps like we discussed, like if the major revenue is not really coming from",
          "timestamp_start": 995.36,
          "timestamp_end": 1000.1,
          "duration_seconds": 4.740000000000009
        },
        {
          "id": "aa621bd7-1e7d-4824-8361-ee6d221a9065",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 250,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "getting people into happy relationships and if they get more money from getting people",
          "timestamp_start": 1000.1,
          "timestamp_end": 1004.08,
          "duration_seconds": 3.980000000000018
        },
        {
          "id": "33d91276-1a96-499a-81fb-ec8bf72880ff",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 251,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "keeping on right swiping on each other and having hookups, that's going to happen.",
          "timestamp_start": 1004.08,
          "timestamp_end": 1007.82,
          "duration_seconds": 3.740000000000009
        },
        {
          "id": "409f0ad3-601e-4ea0-9a18-44078da9aef8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 252,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "The system will actually end up creating the outcomes that are good for the people building this product.",
          "timestamp_start": 1007.82,
          "timestamp_end": 1012.74,
          "duration_seconds": 4.919999999999959
        },
        {
          "id": "70a1dda0-9e9f-4add-92d6-e2fd004e61c5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 253,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Right.",
          "timestamp_start": 1013.1600000000001,
          "timestamp_end": 1013.58,
          "duration_seconds": 0.4199999999999591
        },
        {
          "id": "55fe2e15-eab8-4fc5-99bd-1a897f8e86f6",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 254,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah.",
          "timestamp_start": 1014.36,
          "timestamp_end": 1014.5200000000001,
          "duration_seconds": 0.16000000000008185
        },
        {
          "id": "4b881cec-497b-4ded-9920-0545441f47c1",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 255,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "The incentive is completely misaligned, right?",
          "timestamp_start": 1014.5200000000001,
          "timestamp_end": 1016.4000000000001,
          "duration_seconds": 1.8799999999999955
        },
        {
          "id": "6d347013-1e5f-439b-b1f3-e60eaeab9f54",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 256,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah.",
          "timestamp_start": 1016.44,
          "timestamp_end": 1016.7,
          "duration_seconds": 0.2599999999999909
        },
        {
          "id": "eb090482-e438-4ede-9f34-a500cee1bc62",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 257,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Completely misaligned.",
          "timestamp_start": 1017.12,
          "timestamp_end": 1017.96,
          "duration_seconds": 0.8400000000000318
        }
      ],
      "source_excerpt": "I think the safety aspects came in when I realized that people were really buying into",
