      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "I mean, the story is like insane because a lot of people don't believe this.",
      "timestamp_start": 146.89999999999998,
      "timestamp_end": 151.42,
      "duration_seconds": 4.52000000000001
    },
    {
      "id": "4fee1643-18bc-47f0-8d42-a2db474885ec",
