          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah, exactly.",
          "timestamp_start": 2909.02,
          "timestamp_end": 2909.52,
          "duration_seconds": 0.5
        },
        {
          "id": "3004b72b-9225-4fec-bc67-aaac07f8d350",
