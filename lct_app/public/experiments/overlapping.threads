      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "Yeah.",
      "timestamp_start": 146.67999999999998,
      "timestamp_end": 146.89999999999998,
      "duration_seconds": 0.21999999999999886
    },
    {
      "id": "5f3b50bd-2a95-4e51-841f-0e393ffd59e9",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
