    {
      "id": "demo-m20",
      "node_name": "Reverse-engineering the black box",
      "summary": "Aditya describes interpretability as identifying functional components inside a trained model. He uses image-processing layers and neuroscience as analogies for this investigative approach.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
      "thread_label": null,
      "children_ids": [],
