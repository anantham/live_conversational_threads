      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "People will retreat into their shell, but I don't want to talk to you.",
      "timestamp_start": 4386.82,
      "timestamp_end": 4389.7,
      "duration_seconds": 2.880000000000109
    },
    {
      "id": "d8c4a621-7a87-44fb-a20f-0fa4f5378e01",
