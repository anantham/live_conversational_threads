      "source_turns": [
        {
          "id": "9e349699-bd3d-4266-92d8-1704dd31f47f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 149,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "But you were always thinking about how your mind works,",
          "timestamp_start": 613.48,
          "timestamp_end": 617.7800000000001,
          "duration_seconds": 4.300000000000068
        },
        {
          "id": "9cf54c2c-832e-4a9b-b21f-15289251755c",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 150,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "intelligence, like you were saying, right?",
          "timestamp_start": 617.7800000000001,
          "timestamp_end": 619.72,
          "duration_seconds": 1.9399999999999409
        },
        {
          "id": "9f1f17fd-c5f3-41d8-8dca-0cd70ccff756",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 151,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Did you ever like obsess about things like that,",
          "timestamp_start": 619.72,
          "timestamp_end": 623.86,
          "duration_seconds": 4.139999999999986
        },
        {
          "id": "25aa5dd1-e977-4dbb-90ac-e03e3589a19e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 152,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "consciousness, death, and those kind of topics",
          "timestamp_start": 623.86,
          "timestamp_end": 628.7800000000001,
          "duration_seconds": 4.920000000000073
        },
        {
          "id": "194f9334-baa2-4f61-8052-9013b208764c",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 153,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "when you were like in high school?",
          "timestamp_start": 628.7800000000001,
          "timestamp_end": 632.24,
          "duration_seconds": 3.4599999999999227
        },
        {
          "id": "3bebaede-7b56-413b-9b7d-5a075b9c2408",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 154,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "No, I think honestly speaking, I was more into goosebumps and Archie's and Tintin.",
          "timestamp_start": 633.34,
          "timestamp_end": 642.32,
          "duration_seconds": 8.980000000000018
        },
        {
          "id": "e39093ff-c868-4c9c-8eab-0df430fc5059",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 155,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like I think if you ask me questions about deep questions about metaphysics, right?",
          "timestamp_start": 642.32,
          "timestamp_end": 645.84,
          "duration_seconds": 3.519999999999982
        },
        {
          "id": "e6175386-dd91-433e-89ba-5872de019aec",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 156,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like about consciousness and stuff.",
          "timestamp_start": 645.84,
          "timestamp_end": 647.84,
          "duration_seconds": 2
        },
        {
          "id": "9e243e42-01be-46c2-9827-c7657a396d53",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 157,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I didn't have much of an opinion then.",
          "timestamp_start": 647.84,
          "timestamp_end": 650.5400000000001,
          "duration_seconds": 2.7000000000000455
        },
        {
          "id": "13891eeb-7632-49d5-9311-dad6508851a5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 158,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "It was, yeah, I was way more of the scientific, you know, now I, now I'm understanding where",
          "timestamp_start": 650.5400000000001,
          "timestamp_end": 656.88,
          "duration_seconds": 6.339999999999918
        },
        {
          "id": "dbfa4242-329e-4b4d-b147-7c914c5cd392",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 159,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I was back then.",
          "timestamp_start": 656.88,
          "timestamp_end": 657.88,
          "duration_seconds": 1
        },
        {
          "id": "db7ba0fd-8737-4690-a183-f23e993d4bb9",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 160,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I didn't have the words for it, but I think I kind of believed in the whole reductionist",
          "timestamp_start": 657.88,
          "timestamp_end": 661.72,
          "duration_seconds": 3.840000000000032
        },
        {
          "id": "f63cd19a-f948-4922-89d9-69017eb2c1e4",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 161,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "principles of you take a thing you break into pieces and then you explain the pieces and then",
          "timestamp_start": 661.72,
          "timestamp_end": 666.44,
          "duration_seconds": 4.720000000000027
        },
        {
          "id": "c5ecb5c1-510c-430b-b17e-81fe6a432488",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 162,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "it explains the full the whole is equal to the sum of the parts and not more than it",
          "timestamp_start": 666.44,
          "timestamp_end": 670.84,
          "duration_seconds": 4.399999999999977
        },
        {
          "id": "ae21afa9-1d50-4095-a1a7-7844519b9035",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 163,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "something like that like i was pretty much bought into the scientific explanations for everything",
          "timestamp_start": 672.0400000000001,
          "timestamp_end": 676.0400000000001,
          "duration_seconds": 4
        },
        {
          "id": "b3555b85-2e15-4e18-bbeb-7d059e5c917a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 164,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "i believed in physics and determinism and right i wasn't fascinated by these questions back then",
          "timestamp_start": 676.0400000000001,
          "timestamp_end": 682.2,
          "duration_seconds": 6.159999999999968
        },
        {
          "id": "382076ff-18d2-41f2-a8a1-0d27c1d0271e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 165,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "at least in school levels i was quite i was into anime i was into we did play video games so we",
          "timestamp_start": 682.2,
          "timestamp_end": 688.76,
          "duration_seconds": 6.559999999999945
        },
        {
          "id": "5857d185-dc9e-43a9-a18f-c4b0183f2e19",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 166,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We didn't have a computer at home. It was interesting.",
          "timestamp_start": 688.76,
          "timestamp_end": 691.3199999999999,
          "duration_seconds": 2.5599999999999454
        },
        {
          "id": "08fa6b43-b65f-4e25-9a54-b0ad647dd9df",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 167,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I was like no more watching TV. Mostly I played Game Boy, Pokemon games and so my childhood was pretty like normal kids childhood.",
          "timestamp_start": 691.3199999999999,
          "timestamp_end": 699.4,
          "duration_seconds": 8.080000000000041
        }
      ],
      "source_excerpt": "But you were always thinking about how your mind works,",
      "provenance_utterance_ids": [
        "9e349699-bd3d-4266-92d8-1704dd31f47f",
        "9cf54c2c-832e-4a9b-b21f-15289251755c",
        "9f1f17fd-c5f3-41d8-8dca-0cd70ccff756",
