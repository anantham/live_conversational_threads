    {
      "id": "demo-m10",
      "node_name": "Free products answer to advertisers",
      "summary": "Aditya traces his safety concerns to business models that reward attention and retention. He and the interviewer describe a mismatch between those incentives and users' interests.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
      "thread_label": null,
      "children_ids": [],
