      "source_turns": [
        {
          "id": "5e44b22c-37ec-4c06-8811-09356f296963",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 282,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "that's true that's true so i went to stanford university for a semester and i studied data",
          "timestamp_start": 1140.58,
          "timestamp_end": 1146.8999999999999,
          "duration_seconds": 6.319999999999936
        },
        {
          "id": "970652e9-3344-4daa-b563-e857731d968e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 283,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "science working a project there so that's kind of where my jump happened because i left india",
          "timestamp_start": 1146.9,
          "timestamp_end": 1151.7800000000002,
          "duration_seconds": 4.880000000000109
        },
        {
          "id": "f2e70718-2a8d-4546-be62-af45950b41a7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 284,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "spent two months in california right met other people and silicon valley is the place to be",
          "timestamp_start": 1151.7800000000002,
          "timestamp_end": 1156.74,
          "duration_seconds": 4.959999999999809
        },
        {
          "id": "e6e20fc1-2c92-490d-9475-ac65d757b6db",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 285,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "right like back in 2016 or whatever trump was about to get elected it was like before the election",
          "timestamp_start": 1156.74,
          "timestamp_end": 1163.38,
          "duration_seconds": 6.6400000000001
        },
        {
          "id": "8fec607c-7340-41e0-952e-ee9d939301a4",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 286,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "and it was like i was like meeting people who were really seeing the rise of uh data science and",
          "timestamp_start": 1163.38,
          "timestamp_end": 1170.74,
          "duration_seconds": 7.3599999999999
        },
        {
          "id": "34815749-78cb-433d-9359-f170438600d5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 287,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And before the Facebook scandals and AstraZeneca,",
          "timestamp_start": 1170.74,
          "timestamp_end": 1175.74,
          "duration_seconds": 5
        },
        {
          "id": "2612ae71-998e-4543-add5-d2705a8f2a4b",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 288,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think it was called, what is that company that leaked all",
          "timestamp_start": 1175.74,
          "timestamp_end": 1179.4,
          "duration_seconds": 3.660000000000082
        },
        {
          "id": "7aa8c06d-edc4-4707-862c-b05fb145bdce",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 289,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "the data from Cambridge Analytica?",
          "timestamp_start": 1179.4,
          "timestamp_end": 1181.56,
          "duration_seconds": 2.1599999999998545
        },
        {
          "id": "c4d79287-b234-4f75-932d-8cb725099e77",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 290,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah, Cambridge Analytica.",
          "timestamp_start": 1181.56,
          "timestamp_end": 1182.98,
          "duration_seconds": 1.4200000000000728
        },
        {
          "id": "964e27b6-ba39-4bb1-96b8-6e5c4b206b3f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 291,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So when I went to Stanford, I met other people there",
          "timestamp_start": 1185.74,
          "timestamp_end": 1188.26,
          "duration_seconds": 2.519999999999982
        },
        {
          "id": "3aee6bca-7ad2-4d3f-a269-47e57d2cfaa2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 292,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "who also was technically as interested in mathematics",
          "timestamp_start": 1188.26,
          "timestamp_end": 1192.78,
          "duration_seconds": 4.519999999999982
        },
        {
          "id": "7fbdb589-84c4-40d3-bbf9-e8b73d12ecb9",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 293,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "and physics as me, but also had read books on psychology,",
          "timestamp_start": 1192.78,
          "timestamp_end": 1196.22,
          "duration_seconds": 3.4400000000000546
        },
        {
          "id": "dc44f08d-2b1f-4aa9-98b2-619c0d376604",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 294,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "on philosophy, on political science, economy.",
          "timestamp_start": 1196.22,
          "timestamp_end": 1201.1000000000001,
          "duration_seconds": 4.880000000000109
        },
        {
          "id": "0448abeb-3b92-4c04-9ed4-05b2db90a3aa",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 295,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "They had a holistic education.",
          "timestamp_start": 1201.1000000000001,
          "timestamp_end": 1203.9,
          "duration_seconds": 2.7999999999999545
        },
        {
          "id": "07d630de-1d9d-496d-bd21-6344a2a1d8b3",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 296,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "In India, we have a very narrow, we have engineers.",
          "timestamp_start": 1203.9,
          "timestamp_end": 1207.46,
          "duration_seconds": 3.5599999999999454
        },
        {
          "id": "7373565b-ff89-46ee-a8aa-c4ffe2c23d4d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 297,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We become completely specialists in our field.",
          "timestamp_start": 1207.46,
          "timestamp_end": 1211.7,
          "duration_seconds": 4.240000000000009
        },
        {
          "id": "ccd74502-0c5a-41f0-a0e8-2b053a7418b7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 298,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And for us, politics is not really an issue.",
          "timestamp_start": 1211.7,
          "timestamp_end": 1213.68,
          "duration_seconds": 1.9800000000000182
        },
        {
          "id": "444dfef8-956c-423b-a8d7-0ab35cbf45e8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 299,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We don't talk about politics often because it's not",
          "timestamp_start": 1213.68,
          "timestamp_end": 1217.1000000000001,
          "duration_seconds": 3.4200000000000728
        },
        {
          "id": "330d2e36-8fd7-4423-8244-cfc2f5aaafcc",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 300,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "concerning us.",
          "timestamp_start": 1217.1000000000001,
          "timestamp_end": 1217.84,
          "duration_seconds": 0.7399999999997817
        },
        {
          "id": "d97ed129-e2f4-4920-ab2d-98136689c6ca",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 301,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We have water, we have food, we have money.",
          "timestamp_start": 1217.84,
          "timestamp_end": 1219.9,
          "duration_seconds": 2.060000000000173
        },
        {
          "id": "723c3a8f-703c-44e1-a1da-882338a3599c",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 302,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We have privilege.",
          "timestamp_start": 1219.9,
          "timestamp_end": 1221.88,
          "duration_seconds": 1.9800000000000182
        },
        {
          "id": "4bf30c73-9533-4f59-bdbb-87a1cb4b4838",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 303,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think it was ..",
          "timestamp_start": 1221.88,
          "timestamp_end": 1224.72,
          "duration_seconds": 2.839999999999918
        }
      ],
      "source_excerpt": "that's true that's true so i went to stanford university for a semester and i studied data",
