          "936c0c84-5e56-415a-a772-70a9e4ca77d7",
          "b05fcba8-0a2b-4fbc-960b-f7bdea3c1fb4",
          "49b589af-1031-45db-a171-c557e9198955",
          "cc4b9a54-f452-4fd4-9947-c382d6c0fdec",
          "ede3ff91-f10c-434a-b6a8-38235d33705f",
          "6208da1b-bd93-44ff-a7d9-d91dd0b6299e",
          "d8b52bf2-6db0-4790-93f5-b982ac769e7b",
          "e73aab7e-c8f4-4dc3-8d3b-0b324fcd5fe1",
          "94fdcf19-c223-47d1-a509-0eafa528ba7a",
          "b910ae62-5a87-4076-9ae2-4284da9d75cb",
          "98dd7f83-11b3-4ea9-a7a7-6143e16b8ee1",
          "8d591ce7-04a3-497b-a562-b3d3a6f9caef",
          "d6a2e92e-add1-4768-bfcf-b6d0c09a1915",
          "5f82eb01-ae9c-45b3-b198-acd0e1c8257f",
          "0605e86a-d846-4a98-9fee-0d5098323274",
          "214aec3f-d66d-40eb-a156-7286f6c489da"
        ]
      },
      "source_turns": [
        {
          "id": "23674053-da8f-4060-93c9-93bd024b3513",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1016,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think definitely it's possible because whatever concept I'm trying to point at with",
          "timestamp_start": 4010.36,
          "timestamp_end": 4015.7400000000002,
          "duration_seconds": 5.380000000000109
        },
        {
          "id": "637e098d-3057-4f48-b045-958701e4f339",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1017,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "words or ideas, there will be something similar in your language also.",
          "timestamp_start": 4015.7400000000002,
          "timestamp_end": 4020.04,
          "duration_seconds": 4.299999999999727
        },
        {
          "id": "fac4f87b-c7e9-4eea-909c-bdb14c21322f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1018,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And the language can be English or I'm talking about meaning making narrative structure also.",
          "timestamp_start": 4020.04,
          "timestamp_end": 4023.6000000000004,
          "duration_seconds": 3.5600000000004
        },
        {
          "id": "cfa8a6c1-2e4c-41b2-92d8-f59a78962d55",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1019,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Right now we both are able to become friends or become close because we have shared identity.",
          "timestamp_start": 4023.6,
          "timestamp_end": 4029.8399999999997,
          "duration_seconds": 6.239999999999782
        },
        {
          "id": "ee3ee3a7-c23b-45bf-b96d-1fd7d16cf3ee",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1020,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We're Indians.",
          "timestamp_start": 4029.8399999999997,
          "timestamp_end": 4030.8399999999997,
          "duration_seconds": 1
        },
        {
          "id": "7ed4ec3e-3b1b-4d95-9a10-7282162b114e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1021,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We're men.",
          "timestamp_start": 4030.8399999999997,
          "timestamp_end": 4031.8399999999997,
          "duration_seconds": 1
        },
        {
          "id": "02227d90-664c-490f-af97-61a6002a7bfc",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1022,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We have grown up as a nerd.",
          "timestamp_start": 4031.8399999999997,
          "timestamp_end": 4034.12,
          "duration_seconds": 2.2800000000002
        },
        {
          "id": "cdfb8e33-1d08-4745-aa3b-8bf2c3474f91",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1023,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We have similar...",
          "timestamp_start": 4034.12,
          "timestamp_end": 4035.12,
          "duration_seconds": 1
        },
        {
          "id": "d15dbef1-c98b-4b20-8340-2354aa34d23b",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1024,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So we have a lot of shared values, a lot of shared experiences that allows us to relate",
          "timestamp_start": 4035.12,
          "timestamp_end": 4040.24,
          "duration_seconds": 5.119999999999891
        },
        {
          "id": "14babbb0-38ca-45f2-91cf-fb7e0c45155d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1025,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "to each other.",
          "timestamp_start": 4040.24,
          "timestamp_end": 4042.54,
          "duration_seconds": 2.300000000000182
        },
        {
          "id": "723cd84c-320d-46b6-9986-7e3b9b33a2c4",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1026,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "But maybe you won't be able to relate so deeply.",
          "timestamp_start": 4042.54,
          "timestamp_end": 4049.36,
          "duration_seconds": 6.820000000000164
        },
        {
          "id": "6cfae7aa-fe04-4cfc-ac24-6d30dee1fcbf",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1027,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "But now imagine what if we could do this for more people.",
          "timestamp_start": 4049.36,
          "timestamp_end": 4052.18,
          "duration_seconds": 2.819999999999709
        },
        {
          "id": "878d39a2-98bc-444f-a09c-0f746d6e0ee1",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1028,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "What if you could actually, like someone who lived a very different life compared to us,",
          "timestamp_start": 4052.18,
          "timestamp_end": 4056.8399999999997,
          "duration_seconds": 4.6599999999998545
        },
        {
          "id": "7b3b7c63-a117-459c-872f-3685c8ed0658",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1029,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "might have something in their life which maps to our life but we don't know it.",
          "timestamp_start": 4056.8399999999997,
          "timestamp_end": 4059.7999999999997,
          "duration_seconds": 2.9600000000000364
        },
        {
          "id": "936c0c84-5e56-415a-a772-70a9e4ca77d7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1030,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We don't know how to use those words.",
          "timestamp_start": 4059.7999999999997,
          "timestamp_end": 4061.74,
          "duration_seconds": 1.9400000000000546
        },
        {
          "id": "b05fcba8-0a2b-4fbc-960b-f7bdea3c1fb4",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1031,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "It's so seamless and easy for us because of how close we are in the bubble.",
          "timestamp_start": 4061.74,
          "timestamp_end": 4066.8399999999997,
          "duration_seconds": 5.099999999999909
        },
        {
          "id": "49b589af-1031-45db-a171-c557e9198955",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1032,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So we can actually break these walls.",
          "timestamp_start": 4066.8399999999997,
          "timestamp_end": 4069.3599999999997,
          "duration_seconds": 2.519999999999982
        },
        {
          "id": "cc4b9a54-f452-4fd4-9947-c382d6c0fdec",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1033,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So I think if you look at the six pillars that Sahil talks about, one is this inter-operation,",
          "timestamp_start": 4069.3599999999997,
          "timestamp_end": 4074.24,
          "duration_seconds": 4.880000000000109
        },
        {
          "id": "ede3ff91-f10c-434a-b6a8-38235d33705f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1034,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "which is about how do you really make, how do you translate between bubbles.",
          "timestamp_start": 4074.24,
          "timestamp_end": 4081.18,
          "duration_seconds": 6.940000000000055
        },
        {
          "id": "6208da1b-bd93-44ff-a7d9-d91dd0b6299e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1035,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And I think this is very important because we are already struggling with polarization.",
          "timestamp_start": 4081.18,
          "timestamp_end": 4084.8399999999997,
          "duration_seconds": 3.6599999999998545
        },
        {
          "id": "d8b52bf2-6db0-4790-93f5-b982ac769e7b",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1036,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We're seeing people in their own bubble of Trump or Kamala Harris, political bubbles",
          "timestamp_start": 4084.8399999999997,
          "timestamp_end": 4090.24,
          "duration_seconds": 5.400000000000091
        },
        {
          "id": "e73aab7e-c8f4-4dc3-8d3b-0b324fcd5fe1",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1037,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "are being formed.",
          "timestamp_start": 4090.24,
          "timestamp_end": 4091.24,
          "duration_seconds": 1
        },
        {
          "id": "94fdcf19-c223-47d1-a509-0eafa528ba7a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1038,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We're seeing people in fan clubs.",
          "timestamp_start": 4091.24,
          "timestamp_end": 4093.3199999999997,
          "duration_seconds": 2.0799999999999272
        },
        {
          "id": "b910ae62-5a87-4076-9ae2-4284da9d75cb",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1039,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "The internet is actually creating more and more bubbles and we haven't really found ways",
          "timestamp_start": 4093.3199999999997,
          "timestamp_end": 4097.139999999999,
          "duration_seconds": 3.819999999999709
        },
        {
          "id": "98dd7f83-11b3-4ea9-a7a7-6143e16b8ee1",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1040,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "to allow proper communication between bubbles.",
          "timestamp_start": 4097.139999999999,
          "timestamp_end": 4101.54,
          "duration_seconds": 4.400000000000546
        },
        {
          "id": "8d591ce7-04a3-497b-a562-b3d3a6f9caef",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1041,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So that's a fascinating thing.",
          "timestamp_start": 4101.54,
          "timestamp_end": 4104.42,
          "duration_seconds": 2.880000000000109
        },
        {
          "id": "d6a2e92e-add1-4768-bfcf-b6d0c09a1915",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1042,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Breaking those barriers between people and having that kind of shared, talking in their",
          "timestamp_start": 4104.42,
          "timestamp_end": 4110.58,
          "duration_seconds": 6.1599999999998545
        },
        {
          "id": "5f82eb01-ae9c-45b3-b198-acd0e1c8257f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1043,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "language, right? That is such an important and powerful thing. Even without shared context,",
          "timestamp_start": 4110.58,
          "timestamp_end": 4118.74,
          "duration_seconds": 8.159999999999854
        },
        {
          "id": "0605e86a-d846-4a98-9fee-0d5098323274",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1044,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "even without shared values, but being able to communicate with the other person in their",
          "timestamp_start": 4118.74,
          "timestamp_end": 4122.98,
          "duration_seconds": 4.239999999999782
        },
        {
          "id": "214aec3f-d66d-40eb-a156-7286f6c489da",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1045,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "language. I think that's a very, very fascinating kind of work.",
          "timestamp_start": 4122.98,
          "timestamp_end": 4129.14,
          "duration_seconds": 6.160000000000764
        }
      ],
      "source_excerpt": "I think definitely it's possible because whatever concept I'm trying to point at with",
