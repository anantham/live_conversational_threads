          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "in the AI safety also, even people who agree, disagree, whatever, all of them kind of say",
          "timestamp_start": 2701.54,
