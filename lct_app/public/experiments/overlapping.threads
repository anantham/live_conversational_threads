          "timestamp_end": 4884.82,
          "duration_seconds": 1.7799999999997453
        },
        {
          "id": "340a2fe5-b7e3-42d1-894b-c6db18cf8484",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1243,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I'm sure.",
          "timestamp_start": 4886.08,
          "timestamp_end": 4886.419999999999,
          "duration_seconds": 0.339999999999236
        },
        {
          "id": "3e6cc4b9-c7f1-49cd-b2c4-eeb0717046d7",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1244,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I would love to.",
          "timestamp_start": 4886.66,
          "timestamp_end": 4887.299999999999,
          "duration_seconds": 0.6399999999994179
        },
        {
          "id": "e4c3f269-44b3-4610-b386-5f1f12532d0c",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1245,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah.",
          "timestamp_start": 4887.719999999999,
          "timestamp_end": 4887.94,
          "duration_seconds": 0.22000000000025466
        },
        {
          "id": "14761b67-40c2-42e0-a827-a24f861773e6",
