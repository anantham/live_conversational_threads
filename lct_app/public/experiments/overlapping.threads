      "sequence_number": 880,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "So what happens when you move from a low actuation space where communication was difficult.",
      "timestamp_start": 3420.12,
      "timestamp_end": 3429.3599999999997,
      "duration_seconds": 9.239999999999782
    },
    {
