      "duration_seconds": 1
    },
    {
      "id": "db7ba0fd-8737-4690-a183-f23e993d4bb9",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 160,
