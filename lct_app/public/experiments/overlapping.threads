          "sequence_number": 685,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like even in the most conservative estimate, even the people who think that AI is the whole",
          "timestamp_start": 2709.66,
          "timestamp_end": 2714.66,
          "duration_seconds": 5
        },
        {
