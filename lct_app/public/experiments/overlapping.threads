    {
      "id": "demo-m07",
      "node_name": "Physics came before AI",
      "summary": "Aditya locates his turn toward AI in undergraduate study. His earlier intellectual interests centered on mathematics, quantum mechanics, and cosmology.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
      "thread_label": null,
      "children_ids": [],
      "parent_id": "i04",
