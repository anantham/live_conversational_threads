    {
      "id": "demo-m17",
      "node_name": "Learning by predicting what comes next",
      "summary": "Aditya describes transformer training as adjusting parameters to predict the next token across large text collections. He argues that successful prediction requires sensitivity to content, style, and context.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
