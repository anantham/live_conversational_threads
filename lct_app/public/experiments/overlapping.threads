    {
      "id": "demo-m47",
      "node_name": "Put the person in control of the AI",
      "summary": "Aditya proposes local systems and user control as a response to dependency. He also argues that competition can pressure dominant providers to improve their services.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
