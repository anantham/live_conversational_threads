          "sequence_number": 715,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Thanks a lot for keeping time, dude.",
          "timestamp_start": 2807.7799999999997,
          "timestamp_end": 2809.7799999999997,
          "duration_seconds": 2
        },
        {
          "id": "feea02a6-5076-4192-9eee-1a4eeaa7807b",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 716,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I was willing to take part 1 and part 1.0.5 and take an entire hour for that.",
          "timestamp_start": 2809.78,
          "timestamp_end": 2817.4,
          "duration_seconds": 7.619999999999891
        },
        {
