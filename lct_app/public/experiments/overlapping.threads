      "sequence_number": 177,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "oriented kind of person.",
      "timestamp_start": 746.86,
      "timestamp_end": 747.86,
      "duration_seconds": 1
    },
    {
      "id": "0a473889-cadc-4b87-800e-8a762f955049",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 178,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "like i like i like the quantum mechanics and black holes and that kind of cosmology what is the shape",
      "timestamp_start": 747.86,
      "timestamp_end": 755.94,
      "duration_seconds": 8.080000000000041
    },
    {
      "id": "dd300ca8-a218-48b6-b6a9-434ed53eb811",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 179,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "what is the shape of the universe is the flat or curvature universe will the universe go with a big",
      "timestamp_start": 755.94,
      "timestamp_end": 762.1,
      "duration_seconds": 6.159999999999968
    },
    {
      "id": "768b7ed6-da88-4808-9f3b-0ff7bc41712f",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
