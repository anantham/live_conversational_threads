    {
      "id": "demo-m50",
      "node_name": "The notetaker leaves before the answer",
      "summary": "Aditya notices that the meeting's notetaker has departed and jokes about it. He then explicitly resumes his explanation of open source.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
