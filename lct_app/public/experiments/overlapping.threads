          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "am i living in i don't know if you read the news about amazon employees who have to like time how",
          "timestamp_start": 1109.06,
          "timestamp_end": 1113.9399999999998,
          "duration_seconds": 4.879999999999882
        },
        {
          "id": "c641922a-fb72-45d9-899e-ba3727447941",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
