      "duration_seconds": 2.4600000000000364
    },
    {
      "id": "e67c9fd4-8257-47cc-b60b-440bff4e37bf",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 532,
      "speaker_id": "SPEAKER_00",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "Yeah, I thought that blog post that I read was super fascinating.",
      "timestamp_start": 2086.5,
      "timestamp_end": 2091.44,
      "duration_seconds": 4.940000000000055
    },
    {
      "id": "688de396-48aa-436f-8878-4668ab092714",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 533,
      "speaker_id": "SPEAKER_00",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "It's almost like a human brain, right?",
      "timestamp_start": 2092.2799999999997,
      "timestamp_end": 2094.7,
      "duration_seconds": 2.4200000000000728
    },
    {
      "id": "fcbd465b-98d2-4fc0-85b9-fe81a5161029",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 534,
      "speaker_id": "SPEAKER_00",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "Different areas are kind of different parameters that are associated with different kind of functions.",
