      "sequence_number": 60,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "best education possible right like he wanted to give me he asked me he didn't even put me in",
      "timestamp_start": 280.79999999999995,
      "timestamp_end": 284.88,
      "duration_seconds": 4.080000000000041
    },
    {
      "id": "b9ecf8f1-8076-4de8-98aa-1e830383f6b6",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 61,
      "speaker_id": "SPEAKER_01",
