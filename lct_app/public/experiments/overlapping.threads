    {
      "id": "demo-m09",
      "node_name": "Software made experimentation affordable",
      "summary": "Programming let Aditya build and test things without scarce physical equipment. App development and a college programming club became his route into computing.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
