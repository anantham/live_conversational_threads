    {
      "id": "demo-m19",
      "node_name": "Why does this generalize?",
      "summary": "Aditya asks why very large models generalize instead of merely memorizing, saying theory remains inadequate. The interviewer adds the related problem of explaining particular outputs.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
      "thread_label": null,
      "children_ids": [],
