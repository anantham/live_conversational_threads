          "timestamp_start": 2965.12,
          "timestamp_end": 2967.7200000000003,
          "duration_seconds": 2.600000000000364
        },
        {
          "id": "1d7ff3d6-e62f-483e-97bb-7a940833f560",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 764,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "what these concepts are, right?",
          "timestamp_start": 2967.7200000000003,
          "timestamp_end": 2970.7200000000003,
          "duration_seconds": 3
        },
        {
          "id": "f81a4928-426a-4f2e-9005-fa0a7b1f905b",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 765,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And then we can probably get into why",
          "timestamp_start": 2971.06,
          "timestamp_end": 2974.52,
          "duration_seconds": 3.4600000000000364
        },
        {
          "id": "99d04636-c3d8-4702-b6af-d6d525538164",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 766,
          "speaker_id": "SPEAKER_00",
