          "text": "These are your views.",
          "timestamp_start": 2907.5,
          "timestamp_end": 2908.2799999999997,
          "duration_seconds": 0.7799999999997453
        },
        {
          "id": "9eec4f17-2c7f-4ff0-80e6-069832c2da77",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 745,
          "speaker_id": "SPEAKER_00",
