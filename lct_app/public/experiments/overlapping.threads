    },
    {
      "id": "3bebaede-7b56-413b-9b7d-5a075b9c2408",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 154,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "No, I think honestly speaking, I was more into goosebumps and Archie's and Tintin.",
