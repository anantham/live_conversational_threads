    },
    {
      "id": "6a88c319-d055-4550-9d26-fbdc1c2d4d79",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 395,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "So I think the word GPT stands for",
