      "timestamp_end": 4383.38,
      "duration_seconds": 0.22000000000025466
    },
    {
      "id": "c59b12c3-3e4e-4114-a5ec-b18a0257652b",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
