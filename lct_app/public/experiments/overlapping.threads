          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Correct, correct. And so what do you think about the open source AI models? Like I'm guessing you",
          "timestamp_start": 4465.1,
          "timestamp_end": 4473.860000000001,
          "duration_seconds": 8.760000000000218
        },
        {
          "id": "9ed269b9-77ee-4c71-9430-49027e3ef84b",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1137,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Do you think it's a good idea?",
          "timestamp_start": 4473.86,
          "timestamp_end": 4474.86,
          "duration_seconds": 1
        },
        {
          "id": "188ff9b7-2192-4581-aae2-6eb3c7f4b01c",
