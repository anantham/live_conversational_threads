        },
        {
          "id": "f3d0ac89-c0d9-473e-9f7c-af2764492c11",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 701,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think that would be my biggest, one of the big takeaways.",
          "timestamp_start": 2765.7599999999998,
          "timestamp_end": 2767.9199999999996,
          "duration_seconds": 2.1599999999998545
        },
        {
          "id": "1ef8ee12-9331-4f60-ac36-20ca6bcbe27a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 702,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "That's very...",
          "timestamp_start": 2768.3599999999997,
          "timestamp_end": 2769.52,
          "duration_seconds": 1.1600000000003092
        },
        {
          "id": "9012315a-f2d9-4bd9-ac56-526ae4d95e13",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 703,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "That's a big one, right?",
          "timestamp_start": 2769.52,
          "timestamp_end": 2771.7999999999997,
          "duration_seconds": 2.2799999999997453
        },
        {
          "id": "32d0bd44-df12-4d83-994b-d64cd5b8a8c8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 704,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Like not being able to update your models and act on those models as well.",
          "timestamp_start": 2771.7999999999997,
          "timestamp_end": 2775.48,
          "duration_seconds": 3.680000000000291
        },
        {
          "id": "e5b53035-5fd7-43c7-8b98-2c1544fd064a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 705,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "When you have new information and new evidence on something being different.",
          "timestamp_start": 2776.72,
          "timestamp_end": 2781.4399999999996,
          "duration_seconds": 4.7199999999998
        },
        {
          "id": "dc9d4a29-121e-47d1-84e9-136e0ad9aab7",
