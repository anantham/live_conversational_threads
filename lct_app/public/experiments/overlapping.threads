          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "enhancement, which I'm interested in.",
          "timestamp_start": 3691.16,
          "timestamp_end": 3694.64,
          "duration_seconds": 3.480000000000018
        },
        {
          "id": "aff6fde0-f699-439d-ad2c-c8b431d01535",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 947,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "That is what I'm talking about.",
          "timestamp_start": 3694.64,
          "timestamp_end": 3695.64,
          "duration_seconds": 1
        },
        {
          "id": "9a3cb85b-8788-4cbd-a4c3-a413a0a91755",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 948,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "The difference between the superhuman and the just human level.",
          "timestamp_start": 3695.64,
          "timestamp_end": 3698.4399999999996,
          "duration_seconds": 2.799999999999727
        }
      ],
      "source_excerpt": "But that doesn't, is not necessary for the live theory aspect.",
