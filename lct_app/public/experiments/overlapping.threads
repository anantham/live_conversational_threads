          "timestamp_start": 3661.12,
          "timestamp_end": 3668.3799999999997,
          "duration_seconds": 7.2599999999997635
        },
        {
          "id": "6bc7a5f9-0d3b-429c-ab5b-b4f50436dc68",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 936,
          "speaker_id": "SPEAKER_01",
