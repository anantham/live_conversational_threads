      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 400,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "When I say the word parameters,",
      "timestamp_start": 1611.1999999999998,
      "timestamp_end": 1612.3999999999999,
      "duration_seconds": 1.2000000000000455
    },
    {
      "id": "fd384cf1-a42f-4f02-aa33-6edd3d4596fe",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
