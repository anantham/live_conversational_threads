          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "don't want to waste a second while taking a bath i'll keep a book on the place where you hang the",
          "timestamp_start": 495.42,
          "timestamp_end": 500.06,
          "duration_seconds": 4.639999999999986
        },
