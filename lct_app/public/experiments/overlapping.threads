          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 12,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "details to follow me on. I work in the field of AI safety. I'm currently doing a lot of things,",
          "timestamp_start": 76.44,
          "timestamp_end": 85.4,
          "duration_seconds": 8.960000000000008
        },
        {
          "id": "fc4ad716-9f3e-47dc-a5a1-07f534cd280d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 13,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "but I have in the past and been part of the PhD program at IISC Bangalore in the",
          "timestamp_start": 85.4,
          "timestamp_end": 92.36,
          "duration_seconds": 6.959999999999994
        },
        {
          "id": "be1ae36d-f859-4c5d-a9cc-e476523765a4",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 14,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "computational data science department. I have done my bachelor's from NIT Trichy in instrumentation",
          "timestamp_start": 92.92,
          "timestamp_end": 98.92,
          "duration_seconds": 6
        },
        {
          "id": "d53f57a7-8c4a-4347-98be-f17d98a2a863",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
