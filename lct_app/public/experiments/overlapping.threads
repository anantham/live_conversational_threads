          "speaker_revision": 0,
          "text": "tangents.",
          "timestamp_start": 3686.2,
          "timestamp_end": 3687.2,
          "duration_seconds": 1
        },
        {
          "id": "2a46761b-1efc-4181-9c20-930a6e4935e5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 944,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We can go on.",
          "timestamp_start": 3687.2,
          "timestamp_end": 3688.2,
          "duration_seconds": 1
        },
        {
          "id": "8b48d3fc-71ef-4e35-a399-3997e4d292ad",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 945,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So there's so much possibilities that are possible just in the space of conversation",
          "timestamp_start": 3688.2,
          "timestamp_end": 3691.16,
          "duration_seconds": 2.9600000000000364
        },
        {
          "id": "38092b9f-fe0a-4435-874b-403a7277bf23",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 946,
          "speaker_id": "SPEAKER_01",
