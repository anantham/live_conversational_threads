          "sequence_number": 651,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We are already seeing customer service jobs going away because these systems are quite",
          "timestamp_start": 2548.6400000000003,
