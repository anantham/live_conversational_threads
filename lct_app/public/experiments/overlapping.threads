          "duration_seconds": 1
        },
        {
          "id": "2a180999-aad4-4bbf-b605-655e3d23cc50",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1251,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I hope you enjoy your stay in beautiful countryside, I'm guessing.",
          "timestamp_start": 4897.94,
          "timestamp_end": 4904.94,
          "duration_seconds": 7
        },
        {
          "id": "797af6c1-4acd-4f12-a140-35bf5994dd73",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1252,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Yeah, it's like a couple of hours.",
          "timestamp_start": 4904.94,
          "timestamp_end": 4906.94,
          "duration_seconds": 2
        },
        {
          "id": "17f5e353-9f0d-4cdc-9f32-9dd2ba012735",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1253,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "It's like beautiful countryside here in Georgia.",
          "timestamp_start": 4906.94,
          "timestamp_end": 4910.94,
          "duration_seconds": 4
        },
        {
          "id": "96cf4888-5bc8-4aee-9493-fa16c3a0e734",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1254,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So I'll go out for a nice walk, eat some nice watermelons and tomatoes.",
          "timestamp_start": 4910.94,
          "timestamp_end": 4916.94,
          "duration_seconds": 6
        },
        {
          "id": "6c2837ca-b4b6-4f40-8e39-df927940d5b2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1255,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "They have such fresh fruits here.",
          "timestamp_start": 4916.94,
          "timestamp_end": 4918.94,
          "duration_seconds": 2
        },
        {
          "id": "87c65525-3b5b-4d2e-bdfa-6492221c3fd2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 1256,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Fresh off the farm.",
          "timestamp_start": 4918.94,
          "timestamp_end": 4920.94,
          "duration_seconds": 2
        },
        {
          "id": "d3885cf2-2f8a-449d-a560-9d16846bd5a4",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
