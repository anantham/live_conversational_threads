          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "you.",
          "timestamp_start": 3681.08,
          "timestamp_end": 3682.08,
          "duration_seconds": 1
        },
        {
          "id": "3cfb4259-83b2-4f1b-b44f-af531a27229a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 942,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I can get insights from your second brain, my second brain, which will provide fertile",
          "timestamp_start": 3682.08,
          "timestamp_end": 3686.2,
          "duration_seconds": 4.119999999999891
        },
        {
          "id": "0ff9a743-4430-49b7-9d16-46f5f88d4239",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 943,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
