          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "It's his name, Bishma, Raj.",
          "timestamp_start": 422.65999999999997,
          "timestamp_end": 424.14,
          "duration_seconds": 1.4800000000000182
        },
        {
          "id": "3feb296e-c8c0-40fc-a4aa-fad7de567651",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 97,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think he's 10 years older.",
          "timestamp_start": 427.65999999999997,
          "timestamp_end": 430.14,
          "duration_seconds": 2.480000000000018
        },
        {
          "id": "f42a2629-62e0-4c79-93e5-5af5096f92b8",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 98,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Older?",
          "timestamp_start": 430.14,
          "timestamp_end": 431.14,
          "duration_seconds": 1
        },
        {
          "id": "5c8641a3-04fc-4a5f-aada-41082d593724",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 99,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I wouldn't know him.",
          "timestamp_start": 431.14,
          "timestamp_end": 432.14,
          "duration_seconds": 1
        },
        {
          "id": "07591c61-33c9-47fa-a9a1-cb4a610d6de5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 100,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "He's my age, so 10 years older than Bishma from me.",
          "timestamp_start": 432.14,
          "timestamp_end": 436.14,
          "duration_seconds": 4
        },
        {
          "id": "3c20b487-82ef-4829-99bf-83cca809f7d5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 101,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I don't know how old Bishma is, but yeah.",
          "timestamp_start": 436.14,
          "timestamp_end": 440.09999999999997,
          "duration_seconds": 3.9599999999999795
        },
        {
          "id": "694caa2d-c0b5-456d-89eb-d6889236021d",
