    {
      "id": "demo-m35",
      "node_name": "When ability stops deciding what we do",
      "summary": "Cheap communication illustrates how falling practical barriers expand choices. Aditya asks what then guides action and argues that inexpensive existing AI could already make many small interventions possible.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
