          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "We have not really.",
          "timestamp_start": 2792.22,
          "timestamp_end": 2793.22,
          "duration_seconds": 1
        },
        {
          "id": "a3f24799-edd1-4662-97d6-df801160135b",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 710,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I think we can just do the part two and then do the part three and four, some other time.",
          "timestamp_start": 2793.22,
          "timestamp_end": 2802.7799999999997,
          "duration_seconds": 9.559999999999945
        },
        {
          "id": "57184111-e7e9-472e-b5ba-df85459d4f96",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
