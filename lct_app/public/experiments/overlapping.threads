      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "from Microsoft.",
      "timestamp_start": 4427.42,
      "timestamp_end": 4428.42,
      "duration_seconds": 1
    },
    {
      "id": "5b013189-b42b-4ca5-a393-23aa9867d0fe",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 1129,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "You have to train the AI on your system or like have local open source systems, maybe",
      "timestamp_start": 4428.42,
      "timestamp_end": 4433.84,
      "duration_seconds": 5.420000000000073
    },
    {
