      "source_turns": [
        {
          "id": "17c2f712-b940-45ea-b8e1-dc3ece774e67",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 381,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So can we unpack a few of these things",
          "timestamp_start": 1567.1000000000001,
          "timestamp_end": 1569.26,
          "duration_seconds": 2.1599999999998545
        },
        {
          "id": "2375913c-72b3-41e5-9c6d-26c7d6495ce3",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 382,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "before we move ahead to AI safety, right?",
          "timestamp_start": 1569.26,
          "timestamp_end": 1572.74,
          "duration_seconds": 3.480000000000018
        },
        {
          "id": "84d73856-b3d2-424a-95d4-a24bd338cec0",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 383,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "You spoke about deep learning.",
          "timestamp_start": 1572.74,
          "timestamp_end": 1575.44,
          "duration_seconds": 2.7000000000000455
        },
        {
          "id": "74c303cb-1b97-41f0-af75-f8678bfb6c9d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 384,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Now we have GPT models.",
          "timestamp_start": 1575.44,
          "timestamp_end": 1577.5800000000002,
          "duration_seconds": 2.1400000000001
        },
        {
          "id": "7f519faa-e8f3-4409-8478-21b5232210bf",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 385,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "What are models?",
          "timestamp_start": 1577.5800000000002,
          "timestamp_end": 1578.44,
          "duration_seconds": 0.8599999999999
        },
        {
          "id": "53068f59-e8cc-4c7b-8e57-3981ebea577e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 386,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "What is GPT?",
          "timestamp_start": 1578.44,
          "timestamp_end": 1579.64,
          "duration_seconds": 1.2000000000000455
        },
        {
          "id": "d50759be-ef04-45cc-9fc3-e2c4c0a87cb6",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 387,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "What is, how do you train them?",
          "timestamp_start": 1579.64,
          "timestamp_end": 1581.28,
          "duration_seconds": 1.6399999999998727
        },
        {
          "id": "89294da8-77c2-458f-83c7-2950ddfa6e42",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 388,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "What kind of data do you use?",
          "timestamp_start": 1581.28,
          "timestamp_end": 1583.28,
          "duration_seconds": 2
        },
        {
          "id": "b7098dbf-c60e-46cb-ad9d-12135334b848",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 389,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "What do they exactly do?",
          "timestamp_start": 1583.28,
          "timestamp_end": 1585.44,
          "duration_seconds": 2.160000000000082
        },
        {
          "id": "27ad700d-b277-4205-b8b6-44fa4c321129",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 390,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "I'm sure the audience would want to know",
          "timestamp_start": 1585.44,
          "timestamp_end": 1587.94,
          "duration_seconds": 2.5
        },
        {
          "id": "fc85d0cc-0ed9-44e6-a76d-93868853e06e",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 391,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "how these systems are trained and what they actually do.",
          "timestamp_start": 1587.94,
          "timestamp_end": 1591.48,
          "duration_seconds": 3.5399999999999636
        },
        {
          "id": "98ae644e-2ec1-449c-b1c1-4f4cf3c06d48",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 392,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "You don't have to go deeply technical,",
          "timestamp_start": 1591.48,
          "timestamp_end": 1593.44,
          "duration_seconds": 1.9600000000000364
        },
        {
          "id": "baaa3cdc-52d7-4d9c-ab1b-04abbfcbe794",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 393,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "but at a high level, what these models actually do.",
          "timestamp_start": 1593.44,
          "timestamp_end": 1597.16,
          "duration_seconds": 3.7200000000000273
        },
        {
          "id": "f78d3da1-cdc1-4c07-a184-8b0dfc93fdee",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 394,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "For sure, for sure.",
          "timestamp_start": 1599.02,
          "timestamp_end": 1600.02,
          "duration_seconds": 1
        },
        {
          "id": "6a88c319-d055-4550-9d26-fbdc1c2d4d79",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 395,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So I think the word GPT stands for",
          "timestamp_start": 1600.02,
          "timestamp_end": 1603.1000000000001,
          "duration_seconds": 3.0800000000001546
        },
        {
          "id": "279ee262-7d29-441c-a0de-886a00c02811",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 396,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Generative pre-trained transformer.",
          "timestamp_start": 1603.1,
          "timestamp_end": 1605.4199999999998,
          "duration_seconds": 2.3199999999999363
        },
        {
          "id": "6f8b0fda-c0bf-4c89-b84b-cad117fc3bed",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 397,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "What do you call it?",
          "timestamp_start": 1606.34,
          "timestamp_end": 1607.1799999999998,
          "duration_seconds": 0.8399999999999181
        },
        {
          "id": "ade8b568-ebd5-4015-98dc-8f761e78ff15",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 398,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "It's basically like you take a huge model,",
          "timestamp_start": 1607.1799999999998,
          "timestamp_end": 1609.9399999999998,
          "duration_seconds": 2.759999999999991
        },
        {
          "id": "797b5ba1-93e5-49c7-8b0d-0c4db4aed61f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 399,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "like billions of parameters.",
          "timestamp_start": 1609.9399999999998,
          "timestamp_end": 1611.1999999999998,
          "duration_seconds": 1.259999999999991
        },
        {
          "id": "deaacc37-f2a3-4817-93d5-e208a5609afe",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 400,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "When I say the word parameters,",
          "timestamp_start": 1611.1999999999998,
          "timestamp_end": 1612.3999999999999,
          "duration_seconds": 1.2000000000000455
        },
        {
          "id": "fd384cf1-a42f-4f02-aa33-6edd3d4596fe",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 401,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "you can think of it as you can fit a curve, right?",
          "timestamp_start": 1612.3999999999999,
          "timestamp_end": 1614.56,
          "duration_seconds": 2.160000000000082
        },
        {
          "id": "a41499cd-ecce-4ef8-b1e6-3439f4b3a01f",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 402,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Maybe some of the audience might already be familiar",
          "timestamp_start": 1614.56,
          "timestamp_end": 1617.1999999999998,
          "duration_seconds": 2.6399999999998727
        },
        {
          "id": "427eddcb-772f-43cf-b751-9f7a4016a090",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 403,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "with polynomials or if you have like a graph",
          "timestamp_start": 1617.1999999999998,
          "timestamp_end": 1620.84,
          "duration_seconds": 3.6400000000001
        },
        {
          "id": "484cbeb1-1882-4cec-bb51-c4b304cac648",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 404,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "where you have the different years in the X axis",
          "timestamp_start": 1620.84,
          "timestamp_end": 1623.6,
          "duration_seconds": 2.759999999999991
        },
        {
          "id": "6289d0b8-5554-4ca8-af37-e3c1e70e9d53",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 405,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "and you have the price of a house on the Y axis",
          "timestamp_start": 1623.6,
          "timestamp_end": 1626.52,
          "duration_seconds": 2.9200000000000728
        },
        {
          "id": "1f78cada-2208-4901-be79-ea9669e30c95",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 406,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "and you have a few data points,",
          "timestamp_start": 1626.52,
          "timestamp_end": 1628.04,
          "duration_seconds": 1.5199999999999818
        },
        {
          "id": "a4f566e8-3016-430c-a2bd-cb23238a9b0d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 407,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "you can extrapolate and kind of try to find",
          "timestamp_start": 1628.04,
          "timestamp_end": 1630.5,
          "duration_seconds": 2.4600000000000364
        },
        {
          "id": "16870e55-074b-43c3-821e-4784956c904a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 408,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "what is the trend line to predict how the future",
          "timestamp_start": 1630.5,
          "timestamp_end": 1632.84,
          "duration_seconds": 2.339999999999918
        },
        {
          "id": "775007fe-9486-4225-84ac-d9bbfea083d5",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 409,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "prices of the houses will go so this is like a traditional curve fitting problem where you have",
          "timestamp_start": 1632.84,
          "timestamp_end": 1637.1599999999999,
          "duration_seconds": 4.319999999999936
        },
        {
          "id": "eab79e3a-422b-49b6-a5e3-1243a321a0af",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 410,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "a few data points like say 10 data points and you're trying to use a straight line or a curved",
          "timestamp_start": 1637.72,
          "timestamp_end": 1642.76,
          "duration_seconds": 5.039999999999964
        },
        {
          "id": "f721a0bc-07ba-4560-86c9-d616cf390314",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 411,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "line to try to extrapolate how this curve might look like so the parameters is used here is the",
          "timestamp_start": 1642.76,
          "timestamp_end": 1647.9599999999998,
          "duration_seconds": 5.199999999999818
        },
        {
          "id": "432ed520-fe75-4c21-9cf4-b8fc29420ef6",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 412,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "number of degrees of freedom that you have like if you have a single variable a single parameter",
          "timestamp_start": 1647.9599999999998,
          "timestamp_end": 1652.28,
          "duration_seconds": 4.320000000000164
        },
        {
          "id": "13893122-8f99-4227-a15d-fba61a38fae2",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 413,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "it's like y is equal to mx plus c or mx then m is the only parameter the only free variable",
          "timestamp_start": 1652.28,
          "timestamp_end": 1658.1999999999998,
          "duration_seconds": 5.919999999999845
        },
        {
          "id": "5829e0a8-6b82-40d3-8a3f-8bd2ea1d2d96",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 414,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "which can be varied so depending on the different values of m that line will have different slopes",
          "timestamp_start": 1658.1999999999998,
          "timestamp_end": 1662.76,
          "duration_seconds": 4.560000000000173
        },
        {
          "id": "ac9d67f1-6531-42f1-b7a3-8ec67f4a4c9d",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 415,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And then if you have MX plus C, then you can also adjust the lines intercepted with the X axis.",
          "timestamp_start": 1662.76,
          "timestamp_end": 1667.76,
          "duration_seconds": 5
        },
        {
          "id": "54640e8d-7e37-47b7-8bd5-eb1918607368",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 416,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "And if you have X square, AX square plus BX plus C, if you have like a second order polynomial, then you have two or three parameters.",
          "timestamp_start": 1667.76,
          "timestamp_end": 1675.76,
          "duration_seconds": 8
        },
        {
          "id": "e89f4e46-f499-4a51-ab0f-b5e21afe6bbd",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 417,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "So when I say these models have a lot of parameters, I'm trying to say that they have a lot of degrees of freedom.",
          "timestamp_start": 1675.76,
          "timestamp_end": 1680.76,
          "duration_seconds": 5
        },
        {
          "id": "7273b238-5891-46bb-bd99-75531797a56a",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 418,
          "speaker_id": "SPEAKER_01",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "It's a high dimensional function that is being fitted.",
          "timestamp_start": 1680.76,
          "timestamp_end": 1684.76,
          "duration_seconds": 4
        }
      ],
      "source_excerpt": "So can we unpack a few of these things",
