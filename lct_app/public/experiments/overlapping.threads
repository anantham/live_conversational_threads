      "sequence_number": 397,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "What do you call it?",
      "timestamp_start": 1606.34,
      "timestamp_end": 1607.1799999999998,
      "duration_seconds": 0.8399999999999181
    },
    {
      "id": "ade8b568-ebd5-4015-98dc-8f761e78ff15",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 398,
      "speaker_id": "SPEAKER_01",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "It's basically like you take a huge model,",
      "timestamp_start": 1607.1799999999998,
      "timestamp_end": 1609.9399999999998,
      "duration_seconds": 2.759999999999991
    },
    {
      "id": "797b5ba1-93e5-49c7-8b0d-0c4db4aed61f",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
