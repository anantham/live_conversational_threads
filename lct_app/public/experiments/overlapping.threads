    {
      "id": "demo-m54",
      "node_name": "A tentative restriction without an agreed alarm",
      "summary": "Aditya tentatively favors access for selected researchers. He says broader release would be easier to support with an agreed capability boundary, but fears moving standards and irreversible dissemination.",
      "semantic_level": 1,
      "level": 1,
      "semantic_type": "chunk",
      "thread_id": null,
      "thread_label": null,
      "children_ids": [],
      "parent_id": "i24",
