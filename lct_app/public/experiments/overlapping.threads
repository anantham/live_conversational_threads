          "timestamp_end": 2834.02,
          "duration_seconds": 4.559999999999945
        },
        {
          "id": "a3673bdf-4c06-42d2-96a3-cc852ef18658",
          "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
          "sequence_number": 721,
          "speaker_id": "SPEAKER_00",
          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "Right, right, right.",
