          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "you. Yeah, I'm happy to be here. Like, you might have already noticed I love talking about these",
          "timestamp_start": 49.52,
          "timestamp_end": 56,
          "duration_seconds": 6.479999999999997
        },
        {
          "id": "597853df-b359-4c9a-9058-a0ae7d02da6b",
