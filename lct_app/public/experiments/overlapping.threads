          "speaker_name": null,
          "speaker_source": "model",
          "speaker_confidence": null,
          "speaker_revision": 0,
          "text": "They're logged in a lot of inertial paths.",
          "timestamp_start": 2759.8399999999997,
          "timestamp_end": 2761.68,
          "duration_seconds": 1.8400000000001455
        },
        {
          "id": "7ff1e758-3c89-421f-9395-a2be129e1a8f",
