    {
      "id": "i09",
      "node_name": "Knowing the training procedure does not explain everything",
      "summary": "Questions about generalization and particular outputs motivate investigation inside trained systems.",
      "level": 2,
      "semantic_level": 2,
      "semantic_type": "idea",
      "children_ids": [
        "demo-m19",
        "demo-m20"
      ],
