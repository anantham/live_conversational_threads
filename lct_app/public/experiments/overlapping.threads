        "32a0f47e-529b-4225-bd84-83af6995b363"
      ],
      "sequence_number": 7,
      "argument_role": "context",
      "source_ref": {
        "utterance_ids": [
          "b2926435-344a-4e27-9009-9856a8425bca",
