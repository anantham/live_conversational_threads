    },
    {
      "id": "219f02f0-1368-4d38-94d8-9986ea8516f5",
      "conversation_id": "3fc4885e-a1b3-484e-9c9f-05e51557b9ba",
      "sequence_number": 542,
      "speaker_id": "SPEAKER_00",
      "speaker_name": null,
      "speaker_source": "model",
      "speaker_confidence": null,
      "speaker_revision": 0,
      "text": "And one more, I mean, again, another digression, I think there was some other paper where they",
      "timestamp_start": 2120.52,
      "timestamp_end": 2126,
      "duration_seconds": 5.480000000000018
    },
    {
      "id": "4a1c29b7-45bb-491c-9217-33305b987d1c",
