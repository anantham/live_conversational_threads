# =====================================================================
# OS / editor / sync
# =====================================================================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
# macOS Finder duplicate copies ("filename (1).ext")
* (1).*
# Syncthing conflict/temp files
~syncthing~*
**/~syncthing~*
*.sync-conflict-*
