# =====================================================================
# Secrets & local config — NEVER commit
# =====================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# A `.env` backup/rotation copy holds a live secret — never commit. A bare
# `*.bak` does NOT match `.env.bak.tokenfix` (an AUTH_TOKEN leaked exactly that
# way during the 2026-06-17 rotation incident), so cover any `.env…bak…` backup
# + every `*.tokenfix` artifact explicitly here. (`.env.example`, which has no
# `.bak`, stays tracked.)
.env*.bak*
*.tokenfix
*.bak

# Local-only ops/debug scripts with hardcoded creds/endpoints — never commit
# (audit A7). Rewrite under scripts/ops/ with env vars if a clean version is needed.
lct_python_backend/list_minio.py
lct_python_backend/update_db.py
lct_python_backend/update_pg_settings.py

# =====================================================================
# Conversation data & privacy — real transcripts/audio/exports stay local
# =====================================================================
# .threads sample/test artifacts may contain real conversation data; never
# commit/deploy. The export feature produces these at runtime.
lct_app/public/*.threads
*.threads.json
/saved_json/
/prompts_and_transcripts/
**/recordings/
inputdata/
outputs/
/test_transcript.txt

# =====================================================================
# Runtime state (dev machine) — expected at the root of a running checkout
# =====================================================================
.backend-port
.run/
.postgres_data/
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock
# LLM live telemetry log (seed-then-refine; seed JSON is committed, this is not)
lct_python_backend/data/llm_telemetry.jsonl

# =====================================================================
# Scratch & session artifacts — all scratch belongs in tmp/, never the root
# =====================================================================
tmp/
.tmp/
# Legacy root-scratch convention, retired 2026-07-02 (root swept the same day) —
# patterns kept so any straggler stays ignored.
.tmp_*
.tmp_validation/

# Agent/tool session state
/.claude/
/.serena/
.playwright-mcp/
.worktrees/

# Ad-hoc replay/probe artifacts from ADR/debug sessions
/scripts/ab_test_prompts.py
/scripts/consolidation_observations.json
/scripts/critique_772.py
/scripts/critique_772/
/scripts/dump_llm_inputs_772.py
/scripts/enrich_conversation.py
/scripts/inspect_772.py
/scripts/probe_openai_known_speakers.py
/scripts/replay_772ac0cc.py
/scripts/replay_observations.json
/diagnostic_db_check.py
/test_reactflow_warnings.js

# Local visual verification screenshots and snapshots
/*.png
/overlap-snapshot.yml
threads-viewer-arcs.png
# Raw/original large images (resized versions live in docs/assets/)
/images/

# Misc local dirs
/TheWhisper/
/backups/

