# Append these to the .env that Attendee's init_env.py generates (in your cloned
# attendee repo). They configure: MinIO storage, the local Custom-Async STT, and
# http webhook delivery to the LCT receiver on the Windows host.
#
# Regenerate base .env first (PowerShell, to avoid UTF-16/BOM):
#   docker compose -f dev.docker-compose.yaml run --rm attendee-app-local python init_env.py | Out-File -Encoding utf8 .env
# then append the lines below.

# --- MinIO (local S3-compatible recording store) ---------------------------
# AWS_ENDPOINT_URL is the custom-endpoint key Attendee reads (NOT AWS_S3_ENDPOINT_URL).
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=attendee
AWS_SECRET_ACCESS_KEY=attendeeminio123
AWS_RECORDING_STORAGE_BUCKET_NAME=attendee-recordings
STORAGE_PROTOCOL=s3

# --- Self-hosted STT via the Custom-Async shim -----------------------------
# The worker POSTs each utterance's MP3 here and blocks for the transcript.
# Point at the shim running on the Windows host (attendee_stack/stt_shim.py).
CUSTOM_ASYNC_TRANSCRIPTION_URL=http://host.docker.internal:7878/transcribe
# Raise above 120 if whisperx is slow on long utterances.
CUSTOM_ASYNC_TRANSCRIPTION_TIMEOUT=300

# --- Webhook delivery to the LCT receiver ----------------------------------
# Allow http:// (non-https) webhook URLs at registration for local dev. Register
# the webhook via the project Webhooks UI/API (NOT inline in create-bot, which
# always forces https). REQUIRE_HTTPS_WEBHOOKS gates the project path.
REQUIRE_HTTPS_WEBHOOKS=false
# Only needed if your receiver is https with a self-signed cert (not for plain http):
# DELIVER_WEBHOOK_VERIFY_SSL=false
