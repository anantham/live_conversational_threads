# =============================================================================
# LCT Backend Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# Database
DATABASE_URL=postgresql://lct_user:lct_password@localhost:5433/lct_dev

# --- Security (P0) -----------------------------------------------------------
# Set AUTH_TOKEN to require Bearer token auth on all non-health endpoints.
# Leave empty/unset for development (no auth enforced).
AUTH_TOKEN=

# Set ADMIN_AUTH_TOKEN to require Bearer token auth only on admin/sensitive
# HTTP routes (settings, analytics, bookmarks, conversation listing, deletes)
# while leaving public trial flows anonymous. Ignored when AUTH_TOKEN is set.
ADMIN_AUTH_TOKEN=

# Secret used to sign session middleware cookies. A default dev value is used
# when unset; set a strong random value in production (startup warns otherwise).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# When ENVIRONMENT=production with no AUTH_TOKEN/ADMIN_AUTH_TOKEN, startup
# refuses to boot. Set ALLOW_NO_AUTH=true to explicitly run prod without auth.
ALLOW_NO_AUTH=

# Production frontend origin(s) for CORS. Use FRONTEND_URL for a single origin
# or CORS_ALLOW_ORIGINS for a comma-separated list.
FRONTEND_URL=
CORS_ALLOW_ORIGINS=

# Optional regex for preview deployments (example: https://.*\\.vercel\\.app)
CORS_ALLOW_ORIGIN_REGEX=

# Google OAuth client id used by /share/<token> to verify recipients via
# Google Identity Services. Required only when shares use per-email
# allowlists; public-by-link shares ignore this. Get one from
# https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID,
# Web application). Configure the production frontend origin as an
# authorized JS origin. NO client_secret needed — we verify ID tokens
# against Google's public certs, not exchange them.
GOOGLE_OAUTH_CLIENT_ID=

# Disable /api/import/from-url by default (SSRF risk). Set to true only on
# trusted networks where URL import is needed.
ENABLE_URL_IMPORT=false

# Request body size limits (bytes)
MAX_JSON_BYTES=1048576       # 1 MB
MAX_BODY_BYTES=52428800      # 50 MB
MAX_UPLOAD_BYTES=524288000   # 500 MB (file upload routes only)

# Rate limits (requests per 60-second window, per IP)
RATE_LIMIT_EXPENSIVE=10      # LLM-calling endpoints (analyze, generate)
RATE_LIMIT_MUTATE=60         # POST/PUT/DELETE endpoints
RATE_LIMIT_READ=200          # GET endpoints

# Audio download token (optional; protects /api/conversations/{id}/audio)
AUDIO_DOWNLOAD_TOKEN=

# Server secret for HMAC-signing per-share audio URLs (Phase 3 share
# feature). Each /share/<token> fetch mints a /api/share/<token>/audio
# URL signed for that token + a 1-hour expiry. Without this set, audio
# URLs only verify within a single backend process — recipients will
# need to re-open the share page after a server restart to play audio.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SHARE_AUDIO_SIGNING_KEY=

# Logging - set to DEBUG only when investigating issues
LOG_LEVEL=INFO

# --- API Keys ----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
GOOGLEAI_API_KEY=
GEMINI_API_KEY=
GEMINI_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
PIAPI_API_KEY=
PERPLEXITY_API_KEY=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WS_URL=wss://api.assemblyai.com/v2/realtime/ws

# --- Google Cloud Storage (optional) -----------------------------------------
GCS_BUCKET_NAME=
GCS_FOLDER=

# Conversation save backend: auto (GCS then local fallback), gcs, or local.
SAVE_BACKEND=auto

# --- Environment --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Owner identity used for owner-scoped writes. Self-hosters can override the
# default (usr_aditya) with their own id.
LCT_OWNER_ID=

# --- LLM Runtime Defaults -----------------------------------------------------
# Online-first profile for UI work. Offline/local mode can still be selected in
# Runtime Settings when you want to avoid network spend.
DEFAULT_LLM_MODE=online
ONLINE_LLM_CHAT_MODEL=gemini-3-flash-preview
LOCAL_LLM_BASE_URL=http://100.81.65.74:1234
LOCAL_LLM_CHAT_MODEL=glm-4.6v-flash
LOCAL_LLM_EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
LOCAL_LLM_JSON_MODE=true
LOCAL_LLM_TIMEOUT_SECONDS=120

# API tracing for backend outbound calls (STT + LLM)
TRACE_API_CALLS=true
API_LOG_PREVIEW_CHARS=280

# --- Speaker Diarization ---------------------------------------------------
# Send diarize=true to WhisperX, extract speaker segments, prefix transcript
# with speaker labels for LLM. Requires WhisperX with diarization enabled.
STT_DIARIZE_ENABLED=true

# Online-first live STT defaults: skip local autostart, allow remote routing,
# and use fast OpenAI captions with a separate diarized refinement model.
STT_AUTOSTART=0
DEFAULT_STT_PROVIDER=parakeet
STT_LOCAL_ONLY=false
STT_LIVE_CLOUD_FALLBACK_ENABLED=true
STT_LIVE_REQUIRE_DIARIZATION=true
STT_LIVE_ALLOW_TEXT_ONLY_FALLBACK=false
STT_LIVE_FALLBACK_PRIORITY=openai_audio,remote_whisper,external_http,openrouter_audio
STT_HTTP_TIMEOUT_SECONDS=10
STT_OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
STT_OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize

# --- Path A: Parakeet ASR + separate Pyannote diarization -------------------
# When enabled and provider=parakeet, upload flow requests structured ASR
# timestamps, then runs a second local pyannote pass and aligns speaker turns.
STT_PARAKEET_PYANNOTE_ENABLED=false
STT_PARAKEET_PYANNOTE_RESPONSE_FORMAT=verbose_json
STT_PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
STT_PYANNOTE_DEVICE=cpu
STT_PYANNOTE_HF_TOKEN=
STT_PYANNOTE_MIN_SPEAKERS=
STT_PYANNOTE_MAX_SPEAKERS=

# --- Async diarization queue (post-import background pass) -------------------
# Keeps upload latency lower: return initial graph first, then run slower
# diarization+merge in the background and poll /api/import/diarization-jobs/*.
IMPORT_ASYNC_DIARIZATION_ENABLED=false
IMPORT_ASYNC_DIARIZATION_MAX_QUEUE=4
IMPORT_ASYNC_DIARIZATION_MAX_JOBS=200

# --- Local-only egress guard (the trustworthy zero-cloud-spend switch) -------
# Master switch for ALL cloud egress. When ON (default), every outbound
# inference call (LLM chat, embeddings, STT, fact-check) is checked against a
# local-host allowlist and anything non-local RAISES instead of spending.
# This is the single switch to trust for "run the same audio many times for
# free" — it cannot be flipped by an HTTP/DB setting (process-scoped on
# purpose), and new cloud providers are blocked by default (fail-closed).
#
# "Local" (strict) = loopback + Tailscale (100.64.0.0/10, *.ts.net) + LAN.
# BLOCKED even though they're your own infra: *.modal.run (billed) and all
# paid APIs (OpenAI/OpenRouter/Anthropic/Perplexity/Google).
#
# Behavior when ON: if the local LLM/STT is down, the call FAILS LOUDLY
# rather than silently falling back to a paid provider.
#
# LCT_LOCAL_ONLY=1            # default ON. Set 0 to allow cloud/Modal.
# LCT_LOCAL_ONLY_ALLOW_HOSTS=*.modal.run   # optional escape hatch (host globs)
# NOTE: the ADR-034 public profile sets LCT_LOCAL_ONLY=0 (a VPS has no GPU).

# --- IndrasNet capability gate (ADR-034 §D2) --------------------------------
# IndrasNet provides enrichment: prayer/consumption matching (ADR-013/033),
# contacts picker, unified retrieval (ADR-032). It is the OWNER's private
# system and must NEVER be reachable from the public deployment profile.
#
# Gate policy ("ENABLE flag wins, URL fallback"):
#   - ENABLE_INDRASNET set (1/0/true/false) is authoritative.
#   - If unset, the gate falls back to "is INDRASNET_BASE_URL configured?".
#   - There is NO hardcoded fallback URL — unset means OFF (fail-closed).
#
# Owner profile:   set INDRASNET_BASE_URL (loopback when co-located).
# Public profile:  ENABLE_INDRASNET=0 and leave INDRASNET_BASE_URL unset.
INDRASNET_BASE_URL=http://127.0.0.1:7777
# ENABLE_INDRASNET=1            # optional explicit opt-in (URL still required)
# ENABLE_INDRASNET=0            # public-profile kill switch (overrides URL)

# --- STT Audio Chunking + Pooling -------------------------------------------
# Default Whisper upload target should point to IndrasNet orchestrator.
DEFAULT_STT_WHISPER_HTTP_URL=http://100.81.65.74:7777/api/transcribe

# Upload STT routing policy: prefer local provider first, then fail over to
# remote HTTP provider when local service is unavailable.
STT_UPLOAD_LOCAL_FIRST=true
STT_UPLOAD_REMOTE_FALLBACK=true

# VAD-based chunking: sends speech-boundary-aware audio to WhisperX instead of
# fixed 1.2s slices. Requires silero-vad: pip install silero-vad
STT_VAD_ENABLED=false
STT_VAD_MIN_SECONDS=0.5
STT_VAD_MAX_SECONDS=5.0
STT_VAD_SILENCE_MS=300
STT_VAD_THRESHOLD=0.5

# HTTP connection pooling: reuse one httpx client per recording session
STT_HTTP_POOL_ENABLED=true

# --- Live STT no-audio guard (services/no_audio_guard.py) -------------------
# Avoid paying OpenAI for silence: detect a dead session (no speech ever) and
# auto-pause after sustained trailing silence in a real recording.
STT_NO_AUDIO_GUARD_ENABLED=true
# RMS below this counts as silence (PCM16 sample units; 90 ~ digital silence
# floor on a quiet mic).
STT_NO_AUDIO_RMS_THRESHOLD=90
# Guard A (no speech yet): warn the client at this many seconds of silence...
STT_NO_AUDIO_WARN_AFTER_S=20
# ...and stop forwarding audio at this many seconds.
STT_NO_AUDIO_STOP_AFTER_S=60
# Guard B (speech heard, then trailing silence): emit a one-shot auto_pause WS
# message at this many seconds of post-speech silence.
STT_NO_AUDIO_PAUSE_AFTER_S=300

# --- Free-tier usage quotas (services/quota_service.py) ---------------------
# Free-tier limits when BYOK is not set. record_usage is called on post-flush
# and meters only audio actually forwarded to the provider (see guard above).
FREE_STT_DAILY_MINUTES=10
FREE_LLM_DAILY_TOKENS=50000
# Warn the client at this percent of the limit used (per request).
QUOTA_WARNING_PERCENT=80
# Require BYOK to continue after the free quota is exhausted.
BYOK_REQUIRED_AFTER_FREE=true

# --- Intent Signals / Prayers (ADR-013) -------------------------------------
# Enable Contract C: LLM detection of pre-formal intentions (prayers) in live
# transcript segments.  Off by default until detection quality is calibrated.
INTENT_SIGNAL_DETECTION_ENABLED=false

# Minimum LLM confidence for a detected signal to be persisted (0.0–1.0).
# Items below this threshold are discarded without writing to DB.
INTENT_SIGNAL_CONFIDENCE_THRESHOLD=0.6

# --- Attendee meeting-bot: post-call slow-pass (services/attendee_audio_downloader.py) --
# Off by default. Re-transcribes the bot's own MinIO recording after the meeting
# ends and proposes it as a reviewable transcript revision (never auto-applied).
# Requires `pip install boto3` and a MinIO/S3 endpoint Attendee uploads bot
# recordings to (bucket: attendee-recordings).
ATTENDEE_SLOWPASS_ENABLED=false
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# How long / how often to poll MinIO for the bot's recording after the meeting
# ends — Attendee uploads it asynchronously, so it isn't present instantly.
ATTENDEE_MINIO_POLL_INTERVAL_S=5.0
ATTENDEE_MINIO_POLL_TIMEOUT_S=120.0
